<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Playnite.Avalonia.App</RootNamespace>
    <AssemblyName>Playnite.Avalonia.App</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Playnite.Avalonia\Playnite.Avalonia.csproj" />
    <ProjectReference Include="..\Playnite.Core\Playnite.Core.csproj" />
    <ProjectReference Include="..\Playnite.SDK.V7.Host\Playnite.SDK.V7.Host.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Playnite.WpfPluginSupport\Playnite.WpfPluginSupport.csproj" />
  </ItemGroup>

  <Target Name="CopySdkV7HostBundle" AfterTargets="Build">
    <MSBuild Projects="..\Playnite.SDK.V7.Host\Playnite.SDK.V7.Host.csproj;..\PlayniteSDK.V7\Playnite.SDK.V7.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)"
             BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="SdkV7HostBundle" />
    </MSBuild>
    <Copy SourceFiles="@(SdkV7HostBundle)" DestinationFolder="$(TargetDir)SdkV7Host" SkipUnchangedFiles="true" />
  </Target>

</Project>
