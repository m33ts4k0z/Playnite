<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Playnite.Avalonia.App</RootNamespace>
    <AssemblyName>Playnite.Avalonia.App</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Playnite.Avalonia\Playnite.Avalonia.csproj" />
    <ProjectReference Include="..\Playnite.Core\Playnite.Core.csproj" />
    <ProjectReference Include="..\Playnite.SDK.V7.Host\Playnite.SDK.V7.Host.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Playnite.WpfPluginSupport\Playnite.WpfPluginSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Playnite.SDK.V7.Host\bin\$(Platform)\$(Configuration)\net10.0\Playnite.SDK.V7.Host.dll"
             Link="SdkV7Host\Playnite.SDK.V7.Host.dll"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\PlayniteSDK.V7\bin\$(Platform)\$(Configuration)\net10.0\Playnite.SDK.dll"
             Link="SdkV7Host\Playnite.SDK.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
