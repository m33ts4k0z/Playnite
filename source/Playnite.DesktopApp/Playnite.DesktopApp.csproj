<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>Playnite.DesktopApp</RootNamespace>
    <AssemblyName>Playnite.DesktopApp</AssemblyName>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>x86;x64</Platforms>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <StartupObject>Playnite.DesktopApp.ProgramEntry</StartupObject>
    <ApplicationIcon>Themes\Desktop\Default\Images\applogo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .NET 10 package-aware WPF temporary-project path loses pass-one
         BAML when this project is built through the solution graph. The
         supported legacy path consumes the already resolved references and
         keeps clean solution builds deterministic. -->
    <IncludePackageReferencesDuringMarkupCompilation>false</IncludePackageReferencesDuringMarkupCompilation>
    <PostBuildEvent Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">SETX PLAYNITE_SLN $(SolutionDir)</PostBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Playnite\Playnite.csproj" />
    <ProjectReference Include="..\PlayniteSDK\Playnite.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.8.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HtmlRenderer">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\references\HtmlRenderer.dll</HintPath>
    </Reference>
    <Reference Include="HtmlRenderer.WPF">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\references\HtmlRenderer.WPF.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Default theme files are loose runtime-parsed XAML shipped next to the
         exe, not compiled pages. Themes\Generic.xaml stays compiled. -->
    <Page Remove="Themes\Desktop\**\*.xaml" />
    <Content Include="Themes\Desktop\**\*.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Themes\Desktop\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Playnite\license.txt" Link="license.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\contributors.txt" />
    <Resource Include="..\..\references\Fonts\icofont.ttf" Link="Fonts\icofont.ttf" />
    <Resource Include="Resources\igdbicon.png" />
    <SplashScreen Include="SplashScreen.png" />
  </ItemGroup>

</Project>
