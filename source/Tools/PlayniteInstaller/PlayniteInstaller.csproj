<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>PlayniteInstaller</RootNamespace>
    <AssemblyName>PlayniteInstaller</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installer is standalone (no Playnite reference); it links a small
         set of shared helpers by source, matching the legacy project. -->
    <Compile Include="..\..\PlayniteSDK\Collections\ObservableObject.cs" Link="Shared\ObservableObject.cs" />
    <Compile Include="..\..\PlayniteSDK\ILogger.cs" Link="Shared\ILogger.cs" />
    <Compile Include="..\..\PlayniteSDK\RelayCommand.cs" Link="Shared\RelayCommand.cs" />
    <Compile Include="..\..\Playnite.Core\Common\Extensions\StringExtensions.cs" Link="Shared\StringExtensions.cs" />
    <Compile Include="..\..\Playnite.Core\Common\FileSystem.cs" Link="Shared\FileSystem.cs" />
    <Compile Include="..\..\Playnite.Core\Common\Paths.cs" Link="Shared\Paths.cs" />
    <Compile Include="..\..\Playnite.Core\Common\Resources.cs" Link="Shared\Resources.cs" />
    <Compile Include="..\..\Playnite.Core\Native\Fileapi.cs" Link="Shared\Native\Fileapi.cs" />
    <Compile Include="..\..\Playnite.Core\Native\Kernel32.cs" Link="Shared\Native\Kernel32.cs" />
    <Compile Include="..\..\Playnite.Core\Native\Ntdll.cs" Link="Shared\Native\Ntdll.cs" />
    <Compile Include="..\..\Playnite.Core\Native\Processthreadsapi.cs" Link="Shared\Native\Processthreadsapi.cs" />
    <Compile Include="..\..\Playnite.Core\Native\Shlwapi.cs" Link="Shared\Native\Shlwapi.cs" />
    <Compile Include="..\..\Playnite.Core\Native\Winbase.cs" Link="Shared\Native\Winbase.cs" />
    <Compile Include="..\..\Playnite.Core\Native\Windef.cs" Link="Shared\Native\Windef.cs" />
    <Compile Include="..\..\Playnite.Core\Native\Winnt.cs" Link="Shared\Native\Winnt.cs" />
    <Compile Include="..\..\Playnite.Core\Native\winuser.cs" Link="Shared\Native\winuser.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="installer_mirrors.txt" />
    <Resource Include="playnite-logo-default.ico" />
  </ItemGroup>

</Project>
