<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Playnite.Avalonia.ControlsGallery</RootNamespace>
    <AssemblyName>Playnite.Avalonia.ControlsGallery</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Playnite.Avalonia\Playnite.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Themes\**\*.axaml;Localization\**\*.axaml" />
    <AvaloniaXaml Remove="Themes\**\*.axaml;Localization\**\*.axaml" />
    <Content Include="Themes\**\*.axaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Localization\**\*.axaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
