<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFB3261E" />
    <x:String x:Key="ThemeName">Custom</x:String>
    <x:String x:Key="LayerOrderProbe">theme-custom</x:String>

    <ControlTheme x:Key="{x:Type GamePanel}" TargetType="GamePanel">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="4"
                        CornerRadius="14"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Name="PART_ThemeMarker" Text="custom" IsVisible="False" />
                        <Button Name="PART_ActionButton" Content="Custom theme action" />
                        <TextBlock Name="PART_TitleText"
                                   Text="{TemplateBinding Title}"
                                   FontSize="22"
                                   FontStyle="Italic"
                                   Foreground="White" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
