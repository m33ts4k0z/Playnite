<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Playnite.Avalonia.App.V7.Tests</RootNamespace>
    <AssemblyName>Playnite.Avalonia.App.V7.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Playnite.Avalonia.App\Playnite.Avalonia.App.csproj" />
    <ProjectReference Include="..\TestMetadataPluginV7\TestMetadataPluginV7.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPluginV7\TestPluginV7.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <Target Name="CopySdkV7IntegrationFixture" AfterTargets="Build">
    <RemoveDir Directories="$(TargetDir)V7Fixture" />
    <MSBuild Projects="..\TestPluginV7\TestPluginV7.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="V7LibraryPluginFixture" />
    </MSBuild>
    <MSBuild Projects="..\TestMetadataPluginV7\TestMetadataPluginV7.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="V7MetadataPluginFixture" />
    </MSBuild>
    <MSBuild Projects="..\..\Playnite.SDK.V7.Host\Playnite.SDK.V7.Host.csproj;..\..\PlayniteSDK.V7\Playnite.SDK.V7.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)"
             BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="V7HostFixture" />
    </MSBuild>
    <ItemGroup>
      <V7LibraryPluginFixture Include="..\TestPluginV7\extension.yaml" />
      <V7MetadataPluginFixture Include="..\TestMetadataPluginV7\extension.yaml" />
    </ItemGroup>
    <Copy SourceFiles="@(V7LibraryPluginFixture)" DestinationFolder="$(TargetDir)V7Fixture\Library" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(V7MetadataPluginFixture)" DestinationFolder="$(TargetDir)V7Fixture\Metadata" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(V7HostFixture)" DestinationFolder="$(TargetDir)V7Fixture\Host" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(V7HostFixture)" DestinationFolder="$(TargetDir)SdkV7Host" SkipUnchangedFiles="true" />
  </Target>

</Project>
