<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Playnite.Tests</RootNamespace>
    <AssemblyName>Playnite.Tests</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- The *.xaml under Resources are runtime test fixtures parsed by tests,
         not compiled WPF pages. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <Platforms>x86;x64</Platforms>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Playnite\Playnite.csproj" />
    <ProjectReference Include="..\..\PlayniteSDK\Playnite.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="22.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestApp\TestAppProcInfo.cs" Link="_TestTools\TestAppProcInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\icon_dark.png" />
    <None Update="Resources\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestGameLibrary\extension.yaml" Link="Resources\extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Playnite\Localization\LocSource.xaml" Link="Localization\LocSource.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StageTestFixtures" AfterTargets="Build">
    <PropertyGroup>
      <IgnoreList>$(MSBuildProjectDirectory)\..\..\..\build\ExtensionsRefIgnoreList.txt</IgnoreList>
    </PropertyGroup>
    <!-- Built here rather than via ProjectReference: even with
         ReferenceOutputAssembly=false a referenced exe's apphost gets copied into
         this project's output, which breaks tests scanning it for executables. -->
    <MSBuild Projects="..\TestGameLibrary\TestGameLibrary.csproj;..\TestPlugin\TestPlugin.csproj;..\TestApp\TestApp.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <Exec Command="xcopy &quot;$(MSBuildProjectDirectory)\..\TestGameLibrary\bin\$(Configuration)&quot; &quot;$(TargetDir)Extensions\TestGameLibrary\&quot; /e /y /i /exclude:$(IgnoreList)" />
    <Exec Command="xcopy &quot;$(MSBuildProjectDirectory)\..\TestPlugin\bin\$(Configuration)&quot; &quot;$(TargetDir)Extensions\Tests\&quot; /e /y /i /exclude:$(IgnoreList)" />
    <Exec Command="xcopy &quot;$(MSBuildProjectDirectory)\..\TestApp\bin\$(Configuration)&quot; &quot;$(TargetDir)TestApp\&quot; /e /y /i" />
  </Target>

</Project>
