<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Playnite</RootNamespace>
    <AssemblyName>Playnite</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>x86;x64</Platforms>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- Deferred net10 modernization work: SYSLIB0013/0014 (WebClient/EscapeUriString -> HttpClient migration), CA1416 (false positive from WPF temp project, app is windows-only). -->
    <NoWarn>$(NoWarn);SYSLIB0013;SYSLIB0014;CA1416;CA2022</NoWarn>
    <!-- AssemblyInfo.cs uses a wildcard version (10.56.0.*), which the SDK's
         deterministic default rejects. Same behavior as the legacy project. -->
    <Deterministic>false</Deterministic>
    <!-- Magick.NET x86+x64 are both referenced by design; the copy targets pick per platform. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayniteSDK\Playnite.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="0.9.9" />
    <PackageReference Include="CefSharp.Common.NETCore" Version="147.0.100" />
    <PackageReference Include="CefSharp.OffScreen.NETCore" Version="147.0.100" />
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="147.0.100" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-x64" Version="147.0.10" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-x86" Version="147.0.10" />
    <PackageReference Include="CommandLineParser" Version="2.8.0" />
    <PackageReference Include="Crc32.NET" Version="1.2.0" />
    <PackageReference Include="Flurl" Version="2.7.1" />
    <PackageReference Include="LiteDB" Version="4.1.4" />
    <PackageReference Include="Magick.NET.Core" Version="14.14.0" />
    <PackageReference Include="Magick.NET.SystemWindowsMedia" Version="8.0.23" />
    <PackageReference Include="Magick.NET-Q8-x86" Version="14.14.0" Condition="'$(Platform)' == 'x86'" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.14.0" Condition="'$(Platform)' == 'x64'" />
    <PackageReference Include="Markdig.Signed" Version="0.44.0" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.3" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Nett" Version="0.10.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="4.7.6" />
    <PackageReference Include="PhotoSauce.MagicScaler" Version="0.11.2" />
    <PackageReference Include="Polly" Version="5.1.0" />
    <PackageReference Include="System.Management" Version="10.0.5" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.5" />
    <PackageReference Include="YamlDotNet" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DiscordRPC">
      <HintPath>..\..\references\DiscordRPC.dll</HintPath>
    </Reference>
    <Reference Include="HtmlRenderer">
      <HintPath>..\..\references\HtmlRenderer.dll</HintPath>
    </Reference>
    <Reference Include="HtmlRenderer.WPF">
      <HintPath>..\..\references\HtmlRenderer.WPF.dll</HintPath>
    </Reference>
    <Reference Include="SharpCompress">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\references\SharpCompress.dll</HintPath>
    </Reference>
    <Reference Include="SQLNado">
      <HintPath>..\..\references\SQLNado.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <COMReference Include="IWshRuntimeLibrary">
      <Guid>{F935DC20-1CF0-11D0-ADB9-00C04FD58A0B}</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Language files are loose runtime-parsed XAML, not compiled pages;
         only LocSource.xaml is compiled into the assembly. -->
    <Page Remove="Localization\**\*.xaml" />
    <Page Include="Localization\LocSource.xaml" />
    <None Include="Localization\*.xaml" Exclude="Localization\LocSource.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Localization\locstatus.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Common.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="crash_reporter.cfg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Emulation\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Safe Mode.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources\playnite_extension.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="gamecontrollerdb.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\references\CefSharpRedist\*.*" Condition="'$(Platform)' == 'x86'" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\references\CefSharpRedist\x64\*.*" Condition="'$(Platform)' == 'x64'" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ContentWithTargetPath Include="..\..\references\sqlite3.x86.dll" Condition="'$(Platform)' == 'x86'" Link="Dependencies\sqlite3.x86.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="sqlite3.x86.dll" />
    <ContentWithTargetPath Include="..\..\references\SDL2.dll" Condition="'$(Platform)' == 'x86'" Link="Dependencies\SDL2.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2.dll" />
    <ContentWithTargetPath Include="..\..\references\SDL3.dll" Condition="'$(Platform)' == 'x86'" Link="Dependencies\SDL3.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL3.dll" />
    <ContentWithTargetPath Include="..\..\references\SDL2_mixer.dll" Condition="'$(Platform)' == 'x86'" Link="Dependencies\SDL2_mixer.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2_mixer.dll" />
    <ContentWithTargetPath Include="..\..\references\x64\sqlite3.x64.dll" Condition="'$(Platform)' == 'x64'" Link="Dependencies\sqlite3.x64.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="sqlite3.x64.dll" />
    <ContentWithTargetPath Include="..\..\references\x64\SDL2.dll" Condition="'$(Platform)' == 'x64'" Link="Dependencies\SDL2.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2.dll" />
    <ContentWithTargetPath Include="..\..\references\x64\SDL3.dll" Condition="'$(Platform)' == 'x64'" Link="Dependencies\SDL3.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL3.dll" />
    <ContentWithTargetPath Include="..\..\references\x64\SDL2_mixer.dll" Condition="'$(Platform)' == 'x64'" Link="Dependencies\SDL2_mixer.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2_mixer.dll" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\DesignBackground.jpg" />
    <Resource Include="Resources\Images\DesignCover.jpg" />
    <Resource Include="Resources\Images\DesignIcon.png" />
  </ItemGroup>

</Project>
