<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>Playnite</RootNamespace>
    <AssemblyName>Playnite.Core</AssemblyName>
    <!-- Product version; plugins receive it through CoreRuntime.ApplicationVersion
         in hosts that do not override the hook. -->
    <Version>10.56.0</Version>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x86;x64</Platforms>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- UI-free engine assembly: the portable target uses SDK v7 and excludes
         Win32/COM implementations; the Windows target preserves SDK v6/WPF
         compatibility while the side-by-side applications migrate. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayniteSDK.V7\Playnite.SDK.V7.csproj" Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\PlayniteSDK\Playnite.SDK.csproj" Condition="'$(TargetFramework)' != 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="CommandLineParser" Version="2.8.0" />
    <PackageReference Include="Crc32.NET" Version="1.2.0" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Markdig.Signed" Version="0.44.0" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Flurl" Version="2.7.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Nett" Version="0.10.1" />
    <PackageReference Include="NLog" Version="4.7.6" />
    <PackageReference Include="Polly" Version="5.1.0" />
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.5" />
    <PackageReference Include="System.Management" Version="10.0.5" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="YamlDotNet" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SQLNado" Condition="'$(TargetFramework)' != 'net10.0'">
      <HintPath>..\..\references\SQLNado.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <!-- Windows Script Host interop for .lnk shortcut handling (Programs2.cs).
         Interop types are embedded, so consumers need no extra runtime file.
         Requires VS MSBuild to build (dotnet CLI can't resolve COMReference). -->
    <COMReference Include="IWshRuntimeLibrary">
      <Guid>{F935DC20-1CF0-11D0-ADB9-00C04FD58A0B}</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Common\Programs2.cs" />
    <Compile Remove="Common\Sqlite.cs" />
    <Compile Remove="Emulators\EmulationDatabase.cs" />
    <Compile Remove="Emulators\DatModels.cs" />
    <Compile Remove="SystemIntegration.cs" />
    <Compile Remove="Common\Media\Icons\IconExtractor.cs" />
    <Compile Remove="Common\Media\Icons\IconUtil.cs" />
    <Compile Remove="Common\TGASharpLib.cs" />
    <Compile Remove="HdrUtilities.cs" />
    <Compile Remove="Native\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Playnite" />
    <InternalsVisibleTo Include="Playnite.DesktopApp" />
    <InternalsVisibleTo Include="Playnite.FullscreenApp" />
    <InternalsVisibleTo Include="Playnite.Tests" />
    <InternalsVisibleTo Include="Playnite.Core.Portable.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Emulation\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <ContentWithTargetPath Include="..\..\references\sqlite3.x86.dll" Condition="'$(Platform)' == 'x86'" Link="Dependencies\sqlite3.x86.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="sqlite3.x86.dll" />
    <ContentWithTargetPath Include="..\..\references\x64\sqlite3.x64.dll" Condition="'$(Platform)' == 'x64'" Link="Dependencies\sqlite3.x64.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="sqlite3.x64.dll" />
    <ContentWithTargetPath Include="..\..\references\SDL2.dll" Condition="'$(Platform)' == 'x86'" Link="Dependencies\SDL2.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2.dll" />
    <ContentWithTargetPath Include="..\..\references\SDL3.dll" Condition="'$(Platform)' == 'x86'" Link="Dependencies\SDL3.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL3.dll" />
    <ContentWithTargetPath Include="..\..\references\SDL2_mixer.dll" Condition="'$(Platform)' == 'x86'" Link="Dependencies\SDL2_mixer.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2_mixer.dll" />
    <ContentWithTargetPath Include="..\..\references\x64\SDL2.dll" Condition="'$(Platform)' == 'x64'" Link="Dependencies\SDL2.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2.dll" />
    <ContentWithTargetPath Include="..\..\references\x64\SDL3.dll" Condition="'$(Platform)' == 'x64'" Link="Dependencies\SDL3.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL3.dll" />
    <ContentWithTargetPath Include="..\..\references\x64\SDL2_mixer.dll" Condition="'$(Platform)' == 'x64'" Link="Dependencies\SDL2_mixer.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2_mixer.dll" />
  </ItemGroup>

</Project>
