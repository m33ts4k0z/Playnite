    <x:String x:Key="LOCSettingsScriptingNotice">Estos scripts son ejecutados para todos los juegos en la libreria. Scripts individuales pueden ser asignados a cada juego por separado mientras editas los detalles del juego.</x:String>
    <x:String x:Key="LOCSettingsBackgroundImageAnimation">Animar transiciones de imágenes de fondo</x:String>
    <x:String x:Key="LOCSettingsFontSizes">Tamaño de letra</x:String>
    <x:String x:Key="LOCSettingsTextRenderingModeOptionAuto">Auto</x:String>
    <x:String x:Key="LOCSettingsTextRenderingModeOptionAliased">Aliased</x:String>
