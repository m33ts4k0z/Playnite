    <x:String x:Key="LOCSettingsScriptingNotice">Need skriptid teostatakse igal teegis oleval mängul. Igale mängule eraldi saab skripte määrata mängu üksikasju muutes.</x:String>
    <x:String x:Key="LOCSettingsBackgroundImageAnimation">Animeeri taustapiltide üleminekud</x:String>
    <x:String x:Key="LOCSettingsFontSizes">Kirja suurused</x:String>
    <x:String x:Key="LOCSettingsTextRenderingModeOptionAuto">Automaatne</x:String>
    <x:String x:Key="LOCSettingsTextRenderingModeOptionAliased">Sakiline</x:String>
