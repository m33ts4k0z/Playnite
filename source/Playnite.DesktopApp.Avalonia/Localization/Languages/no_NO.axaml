    <x:String x:Key="LOCSettingsScriptingNotice">Disse skriptene blir utført for hvert spill på biblioteket. Individuelle skript kan tilordnes hvert spill separat når du redigerer spilldetaljer.</x:String>
    <x:String x:Key="LOCSettingsBackgroundImageAnimation">Animer bakgrunnsoverganger</x:String>
    <x:String x:Key="LOCSettingsFontSizes">Skriftstørrelser</x:String>
