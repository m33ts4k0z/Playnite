    <x:String x:Key="LOCSettingsTextRenderingModeOptionAliased">دندانه‌ای شده</x:String>
    <x:String x:Key="LOCSettingsTextRenderingModeOptionGrayscale">درجه‌ی خاکستری</x:String>
