    <x:String x:Key="LOCSettingsDefaultMetadataDescription">Configuració de descàrrega automàtica de metadades per a jocs recentment importats.</x:String>
    <x:String x:Key="LOCSettingsTargetDisplay">Pantalla objectiu</x:String>
    <x:String x:Key="LOCSettingsAlwaysUsePrimaryDisplay">Utilitzar sempre la pantalla principal</x:String>
    <x:String x:Key="LOCSettingsFullscreenShowGameTitles">Mostrar títols dels jocs</x:String>
    <x:String x:Key="LOCSettingsShowBatteryStatus">Mostrar estat de la bateria</x:String>
