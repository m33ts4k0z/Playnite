<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>Playnite.DesktopApp.Avalonia</RootNamespace>
    <AssemblyName>Playnite.DesktopApp.Avalonia</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(TargetFramework)' != 'net10.0'">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationManifest Condition="'$(TargetFramework)' != 'net10.0' Or '$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Playnite.Avalonia.App\Playnite.Avalonia.App.csproj"
                      Condition="'$(TargetFramework)' != 'net10.0'" />
    <ProjectReference Include="..\Playnite.Avalonia.WebView\Playnite.Avalonia.WebView.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\Playnite.Avalonia\Playnite.Avalonia.csproj" />
    <ProjectReference Include="..\Playnite.Core\Playnite.Core.csproj" />
    <ProjectReference Include="..\Playnite.WpfPluginSupport\Playnite.WpfPluginSupport.csproj"
                      Condition="'$(TargetFramework)' != 'net10.0'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="App.cs;MainWindow.cs;DesktopPilotSelfTest.cs;InstalledPluginCompatibilityTest.cs" />
    <Compile Remove="Controls\**\*.cs;Services\**\*.cs;ViewModels\**\*.cs;Views\**\*.cs" />
    <AvaloniaXaml Remove="Views\**\*.axaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="App.Portable.cs;MainWindow.Portable.cs;DesktopLibrary.Portable.cs;PortableTrayService.cs;PortableWebViewSelfTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Themes\**\*.axaml;Localization\**\*.axaml" />
    <AvaloniaXaml Remove="Themes\**\*.axaml;Localization\**\*.axaml" />
    <Content Include="Themes\**\*.axaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Themes\**\theme.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Localization\**\*.axaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Playnite.DesktopApp\Themes\Desktop\Default\Images\applogo.png"
             Condition="'$(TargetFramework)' == 'net10.0'"
             Link="Assets\applogo.png"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Playnite.DesktopApp\Themes\Desktop\Default\Images\applogo.ico"
             Condition="'$(TargetFramework)' != 'net10.0'"
             Link="Assets\applogo.ico"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\tray-default.png;Assets\tray-bright.png;Assets\tray-dark.png"
             Condition="'$(TargetFramework)' != 'net10.0'"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
