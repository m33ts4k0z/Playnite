<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Playnite.DesktopApp.Avalonia.ViewModels"
             x:Class="Playnite.DesktopApp.Avalonia.Views.Settings.ScriptingSettingsView"
             x:DataType="vm:ScriptingSettingsSection">
  <Grid Margin="24" RowDefinitions="*,Auto" RowSpacing="12">
    <TabControl>
      <TabItem Header="Game lifecycle">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Before a game starts" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Test" Command="{Binding TestPreScriptCommand}" />
            </Grid>
            <TextBox Text="{Binding GlobalPreScript, Mode=TwoWay}"
                     AcceptsReturn="True" MinHeight="115"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource DesktopMonospaceFontFamily}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBlock Text="After the game has started" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Test" Command="{Binding TestGameStartedScriptCommand}" />
            </Grid>
            <TextBox Text="{Binding GlobalGameStartedScript, Mode=TwoWay}"
                     AcceptsReturn="True" MinHeight="115"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource DesktopMonospaceFontFamily}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBlock Text="After the game exits" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Test" Command="{Binding TestPostScriptCommand}" />
            </Grid>
            <TextBox Text="{Binding GlobalPostScript, Mode=TwoWay}"
                     AcceptsReturn="True" MinHeight="115"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource DesktopMonospaceFontFamily}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Application lifecycle">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" Spacing="8">
            <TextBlock Text="Application scripts receive $PlayniteApi and run after plugins initialize or before they unload."
                       TextWrapping="Wrap" Opacity="0.75" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBlock Text="After Playnite starts" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Test" Command="{Binding TestStartupScriptCommand}" />
            </Grid>
            <TextBox Text="{Binding AppStartupScript, Mode=TwoWay}"
                     AcceptsReturn="True" MinHeight="150"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource DesktopMonospaceFontFamily}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBlock Text="Before Playnite shuts down" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Test" Command="{Binding TestShutdownScriptCommand}" />
            </Grid>
            <TextBox Text="{Binding AppShutdownScript, Mode=TwoWay}"
                     AcceptsReturn="True" MinHeight="150"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource DesktopMonospaceFontFamily}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="1" Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.8" />
  </Grid>
</UserControl>
