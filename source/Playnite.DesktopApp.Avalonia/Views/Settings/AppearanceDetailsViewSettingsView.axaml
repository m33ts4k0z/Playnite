<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Playnite.DesktopApp.Avalonia.ViewModels"
             x:Class="Playnite.DesktopApp.Avalonia.Views.Settings.AppearanceDetailsViewSettingsView"
             x:DataType="vm:AppearanceDetailsViewSettingsSection">
    <ScrollViewer MaxHeight="470" Padding="18,0,4,0">
        <StackPanel Spacing="14">
            <TextBlock Text="Visible fields" Classes="sectionLabel" />
            <WrapPanel ItemWidth="215" ItemHeight="30">
                <CheckBox Content="Name" IsChecked="{Binding Visibility.Name, Mode=TwoWay}" />
                <CheckBox Content="Library" IsChecked="{Binding Visibility.Library, Mode=TwoWay}" />
                <CheckBox Content="Source" IsChecked="{Binding Visibility.Source, Mode=TwoWay}" />
                <CheckBox Content="Platform" IsChecked="{Binding Visibility.Platform, Mode=TwoWay}" />
                <CheckBox Content="Release date" IsChecked="{Binding Visibility.ReleaseDate, Mode=TwoWay}" />
                <CheckBox Content="Play time" IsChecked="{Binding Visibility.PlayTime, Mode=TwoWay}" />
                <CheckBox Content="Last played" IsChecked="{Binding Visibility.LastPlayed, Mode=TwoWay}" />
                <CheckBox Content="Recent activity" IsChecked="{Binding Visibility.RecentActivity, Mode=TwoWay}" />
                <CheckBox Content="Added" IsChecked="{Binding Visibility.Added, Mode=TwoWay}" />
                <CheckBox Content="Completion status" IsChecked="{Binding Visibility.CompletionStatus, Mode=TwoWay}" />
                <CheckBox Content="Icon" IsChecked="{Binding Visibility.Icon, Mode=TwoWay}" />
                <CheckBox Content="Cover image" IsChecked="{Binding Visibility.CoverImage, Mode=TwoWay}" />
                <CheckBox Content="Background image" IsChecked="{Binding Visibility.BackgroundImage, Mode=TwoWay}" />
                <CheckBox Content="Genres" IsChecked="{Binding Visibility.Genres, Mode=TwoWay}" />
                <CheckBox Content="Categories" IsChecked="{Binding Visibility.Categories, Mode=TwoWay}" />
                <CheckBox Content="Tags" IsChecked="{Binding Visibility.Tags, Mode=TwoWay}" />
                <CheckBox Content="Features" IsChecked="{Binding Visibility.Features, Mode=TwoWay}" />
                <CheckBox Content="Developers" IsChecked="{Binding Visibility.Developers, Mode=TwoWay}" />
                <CheckBox Content="Publishers" IsChecked="{Binding Visibility.Publishers, Mode=TwoWay}" />
                <CheckBox Content="Series" IsChecked="{Binding Visibility.Series, Mode=TwoWay}" />
                <CheckBox Content="Age rating" IsChecked="{Binding Visibility.AgeRating, Mode=TwoWay}" />
                <CheckBox Content="Region" IsChecked="{Binding Visibility.Region, Mode=TwoWay}" />
                <CheckBox Content="Links" IsChecked="{Binding Visibility.Links, Mode=TwoWay}" />
                <CheckBox Content="Description" IsChecked="{Binding Visibility.Description, Mode=TwoWay}" />
                <CheckBox Content="Version" IsChecked="{Binding Visibility.Version, Mode=TwoWay}" />
                <CheckBox Content="Install size" IsChecked="{Binding Visibility.InstallSize, Mode=TwoWay}" />
                <CheckBox Content="Install directory" IsChecked="{Binding Visibility.InstallDirectory, Mode=TwoWay}" />
                <CheckBox Content="Community score" IsChecked="{Binding Visibility.CommunityScore, Mode=TwoWay}" />
                <CheckBox Content="Critic score" IsChecked="{Binding Visibility.CriticScore, Mode=TwoWay}" />
                <CheckBox Content="User score" IsChecked="{Binding Visibility.UserScore, Mode=TwoWay}" />
                <CheckBox Content="Notes" IsChecked="{Binding Visibility.Notes, Mode=TwoWay}" />
            </WrapPanel>

            <Border Height="1" Background="{DynamicResource DesktopBorderBrush}" Margin="0,4" />
            <TextBlock Text="Details geometry" Classes="sectionLabel" />
            <CheckBox Content="Indent game details" IsChecked="{Binding IndentGameDetails, Mode=TwoWay}" />
            <Grid ColumnDefinitions="240,150" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                <TextBlock Text="Indentation" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="200"
                               Value="{Binding GameDetailsIndentation, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Text="Cover height" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="100" Maximum="800" Increment="10"
                               Value="{Binding GameDetailsCoverHeight, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Text="List icon size" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="20" Maximum="160"
                               Value="{Binding DetailsViewListIconSize, Mode=TwoWay}" />
            </Grid>

            <Border Height="1" Background="{DynamicResource DesktopBorderBrush}" Margin="0,4" />
            <TextBlock Text="Scrolling" Classes="sectionLabel" />
            <CheckBox Content="Smooth scrolling" IsChecked="{Binding SmoothScrollEnabled, Mode=TwoWay}" />
            <Grid ColumnDefinitions="240,150" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                <TextBlock Text="Wheel sensitivity" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="0.1" Maximum="10" Increment="0.1"
                               FormatString="0.0" Value="{Binding ScrollSensitivity, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Text="Animation duration (ms)" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="16" Maximum="5000" Increment="25"
                               Value="{Binding ScrollDurationMilliseconds, Mode=TwoWay}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
