<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Playnite.DesktopApp.Avalonia.ViewModels"
             x:Class="Playnite.DesktopApp.Avalonia.Views.Settings.PerformanceSettingsView"
             x:DataType="vm:PerformanceSettingsSection">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="14">
      <TextBlock Text="Rendering and media" FontSize="18" FontWeight="SemiBold" />
      <CheckBox Content="Load images asynchronously"
                IsChecked="{Binding AsyncImageLoading, Mode=TwoWay}" />
      <TextBlock Text="Decodes local images away from the UI thread for smoother scrolling. Changing this option requires restart."
                 TextWrapping="Wrap" Opacity="0.75" />
      <CheckBox Content="Disable hardware acceleration"
                IsChecked="{Binding DisableHwAcceleration, Mode=TwoWay}" />
      <TextBlock Text="Forces Avalonia/Skia software rendering on Windows and Linux. Use this only to work around graphics-driver problems; changing it requires restart."
                 TextWrapping="Wrap" Opacity="0.75" />
      <CheckBox Content="Warn when selected game images are too large"
                IsChecked="{Binding ShowImagePerformanceWarning, Mode=TwoWay}" />

      <Border BorderBrush="#446A6A6A" BorderThickness="1" Padding="10" Margin="0,8,0,0">
        <TextBlock Text="The old composition web-view renderer, partial-description loading, and global image-scaler mode were WPF-specific. Avalonia uses its native web-view lifecycle and Skia image sampling, so those switches do not apply."
                   TextWrapping="Wrap" Opacity="0.75" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
