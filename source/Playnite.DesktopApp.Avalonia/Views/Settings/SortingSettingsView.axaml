<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Playnite.DesktopApp.Avalonia.ViewModels"
             x:Class="Playnite.DesktopApp.Avalonia.Views.Settings.SortingSettingsView"
             x:DataType="vm:SortingSettingsSection">
    <ScrollViewer MaxHeight="470" Padding="18,0,4,0">
        <StackPanel Spacing="14">
            <TextBlock Text="Sorting names" Classes="sectionLabel" />
            <CheckBox Content="Automatically fill sorting names for newly imported games"
                      IsChecked="{Binding GameSortingNameAutofill, Mode=TwoWay}" />
            <TextBlock Text="Articles removed from the start of titles" />
            <ListBox MinHeight="190" ItemsSource="{Binding RemovedArticles}"
                     SelectedItem="{Binding SelectedArticle, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox PlaceholderText="Article (for example: The)" Text="{Binding ArticleText, Mode=TwoWay}" />
                <Button Grid.Column="1" Content="Add" Command="{Binding AddArticleCommand}" />
                <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveArticleCommand}" />
            </Grid>
            <Button Content="Fill missing sorting names for the library"
                    Command="{Binding FillSortingNamesCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="Bulk fill updates only games without a sorting name and uses a buffered database update."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource DesktopMutedBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
