<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Playnite.DesktopApp.Avalonia.ViewModels"
             x:Class="Playnite.DesktopApp.Avalonia.Views.Settings.AppearanceSettingsView"
             x:DataType="vm:AppearanceSettingsSection">
    <ScrollViewer MaxHeight="470" Padding="18,0,4,0">
        <StackPanel Spacing="14">
            <TextBlock Text="{DynamicResource LOCThemes}" Classes="sectionLabel" />
            <ComboBox MinWidth="260" HorizontalAlignment="Left"
                      ItemsSource="{Binding AvailableThemes}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
            <TextBlock Text="Additional themes appear here once installed to your Themes\Desktop folder. Changing the theme restarts Playnite."
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource DesktopMutedBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
