<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Playnite.DesktopApp.Avalonia.Controls"
                    xmlns:foundation="using:Playnite.Avalonia.Controls">

    <SolidColorBrush x:Key="DesktopBackgroundBrush" Color="#10141B" />
    <SolidColorBrush x:Key="DesktopPanelBrush" Color="#171D26" />
    <SolidColorBrush x:Key="DesktopPanelStrongBrush" Color="#202834" />
    <SolidColorBrush x:Key="DesktopAccentBrush" Color="#00A8E8" />
    <SolidColorBrush x:Key="DesktopTextBrush" Color="#F3F6FA" />
    <SolidColorBrush x:Key="DesktopMutedBrush" Color="#9EABBA" />

    <ControlTheme x:Key="{x:Type local:DesktopWindowChrome}"
                  TargetType="local:DesktopWindowChrome">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="42,*" Background="{DynamicResource DesktopBackgroundBrush}">
                    <Border Name="PART_TitleBar"
                            Background="{DynamicResource DesktopPanelStrongBrush}"
                            BorderBrush="#303A49" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0"
                                        IsHitTestVisible="False" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="6"
                                        Background="{DynamicResource DesktopAccentBrush}">
                                    <TextBlock Text="P" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Playnite — Avalonia Desktop Pilot"
                                           Foreground="{DynamicResource DesktopTextBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Name="PART_MinimizeButton" Classes="windowCaption"
                                        Content="—" ToolTip.Tip="Minimize" />
                                <Button Name="PART_MaximizeButton" Classes="windowCaption"
                                        Content="□" ToolTip.Tip="Maximize or restore" />
                                <Button Name="PART_CloseButton" Classes="windowCaption windowClose"
                                        Content="×" ToolTip.Tip="Close" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ContentPresenter Grid.Row="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:DesktopMainView}"
                  TargetType="local:DesktopMainView">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="{DynamicResource DesktopBackgroundBrush}"
                      RowDefinitions="64,*,34">
                    <Border Background="{DynamicResource DesktopPanelStrongBrush}"
                            BorderBrush="#303A49" BorderThickness="0,0,0,1"
                            Padding="24,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="9"
                                        Background="{DynamicResource DesktopAccentBrush}">
                                    <TextBlock Text="P" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Playnite" FontSize="23" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DesktopTextBrush}"
                                           VerticalAlignment="Center" />
                                <Border Background="#263140" CornerRadius="12" Padding="9,4">
                                    <TextBlock Text="Avalonia Desktop" FontSize="12"
                                               Foreground="{DynamicResource DesktopAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding LibrarySummary}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DesktopMutedBrush}" />
                                <Button Command="{Binding ToggleNotificationsCommand}"
                                        Content="{Binding NotificationCount, StringFormat='Notifications ({0})'}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="270,*,390">
                        <Border Background="{DynamicResource DesktopPanelBrush}"
                                BorderBrush="#303A49" BorderThickness="0,0,1,0"
                                Padding="20">
                            <ScrollViewer>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{DynamicResource LOCDesktopLibrary}"
                                               FontSize="25" FontWeight="Bold"
                                               Foreground="{DynamicResource DesktopTextBrush}" />
                                    <TextBox Name="PART_SearchBox"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             Watermark="Search games"
                                             Padding="12,9" />
                                    <TextBlock Text="{Binding LibrarySummary}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <Border Height="1" Background="#303A49" Margin="0,5" />
                                    <TextBlock Text="{DynamicResource LOCDesktopPreset}" Classes="sectionLabel" />
                                    <ComboBox ItemsSource="{Binding FilterPresets}"
                                              SelectedItem="{Binding SelectedFilterPreset, Mode=TwoWay}" />
                                    <CheckBox Content="{DynamicResource LOCDesktopInstalled}"
                                              IsChecked="{Binding InstalledOnly, Mode=TwoWay}" />
                                    <CheckBox Content="{DynamicResource LOCDesktopFavorites}"
                                              IsChecked="{Binding FavoritesOnly, Mode=TwoWay}" />
                                    <Border Height="1" Background="#303A49" Margin="0,5" />
                                    <TextBlock Text="{DynamicResource LOCDesktopView}" Classes="sectionLabel" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="nav" Command="{Binding SetGridViewCommand}"
                                                Content="Grid" />
                                        <Button Classes="nav" Command="{Binding SetListViewCommand}"
                                                Content="List" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource LOCDesktopSort}" Classes="sectionLabel" />
                                    <ComboBox ItemsSource="{Binding SortOptions}"
                                              SelectedItem="{Binding SelectedSortOrder, Mode=TwoWay}" />
                                    <ComboBox ItemsSource="{Binding SortDirectionOptions}"
                                              SelectedItem="{Binding SelectedSortDirection, Mode=TwoWay}" />
                                    <TextBlock Text="{DynamicResource LOCDesktopGroup}" Classes="sectionLabel" />
                                    <ComboBox ItemsSource="{Binding GroupingOptions}"
                                              SelectedItem="{Binding SelectedGrouping, Mode=TwoWay}" />
                                    <Border Background="#202A37" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding PluginSummary}" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource LOCDesktopWindowTray}" Classes="sectionLabel" />
                                    <CheckBox Content="{DynamicResource LOCDesktopEnableTray}"
                                              IsChecked="{Binding EnableTray, Mode=TwoWay}" />
                                    <CheckBox Content="{DynamicResource LOCDesktopMinimizeTray}"
                                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                                    <CheckBox Content="{DynamicResource LOCDesktopCloseTray}"
                                              IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                                    <Button Content="{DynamicResource LOCDesktopUpdateLibraries}"
                                            Command="{Binding OpenLibrarySyncCommand}" />
                                    <Button Content="{DynamicResource LOCDesktopImportInstalled}"
                                            Command="{Binding OpenInstalledGameImportCommand}" />
                                    <Button Content="{DynamicResource LOCDesktopAddManualGame}"
                                            Command="{Binding AddManualGameCommand}" />
                                    <Button Content="{DynamicResource LOCDesktopPluginSettings}"
                                            Command="{Binding OpenPluginSettingsListCommand}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="1">
                            <ListBox Name="PART_GridGameList"
                                     Margin="18,14"
                                     IsVisible="{Binding IsGridView}"
                                     Background="Transparent"
                                     ItemsSource="{Binding Games}"
                                     SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <foundation:UniformGridVirtualizingPanel ItemWidth="180" ItemHeight="258" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="desktopTile" Margin="6" CornerRadius="8"
                                                Background="{DynamicResource DesktopPanelBrush}"
                                                BorderBrush="Transparent" BorderThickness="2"
                                                ClipToBounds="True">
                                            <Grid RowDefinitions="*,Auto">
                                                <Border Background="#222B37">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" Margin="14"
                                                                   FontSize="22" FontWeight="Bold"
                                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                                   Foreground="#536579"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <foundation:GameCoverImage SourcePath="{Binding CoverPath}"
                                                                                    Stretch="UniformToFill" />
                                                        <Border IsVisible="{Binding ShowGroupHeader}"
                                                                VerticalAlignment="Top" Padding="8,4"
                                                                Background="#E600A8E8">
                                                            <TextBlock Text="{Binding GroupHeader}" FontSize="11"
                                                                       FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                        <Border IsVisible="{Binding Favorite}" HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom" Padding="7,3"
                                                                Background="#D900A8E8" CornerRadius="6,0,0,0">
                                                            <TextBlock Text="★" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="11,8" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource DesktopTextBrush}" />
                                                    <TextBlock Text="{Binding StateText}" FontSize="11"
                                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox Name="PART_ListGameList"
                                     Margin="18,14"
                                     IsVisible="{Binding IsListView}"
                                     Background="Transparent"
                                     ItemsSource="{Binding Games}"
                                     SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border IsVisible="{Binding ShowGroupHeader}"
                                                    Margin="4,14,4,4" Padding="10,5"
                                                    Background="#26394A" CornerRadius="5">
                                                <TextBlock Text="{Binding GroupHeader}" FontWeight="Bold"
                                                           Foreground="{DynamicResource DesktopAccentBrush}" />
                                            </Border>
                                            <Border Classes="desktopRow" Margin="3" Padding="10"
                                                    CornerRadius="6" Background="{DynamicResource DesktopPanelBrush}"
                                                    BorderBrush="Transparent" BorderThickness="1">
                                                <Grid ColumnDefinitions="48,2*,*,*,Auto" ColumnSpacing="12">
                                                    <Border Width="42" Height="56" Background="#222B37"
                                                            CornerRadius="4" ClipToBounds="True">
                                                        <foundation:GameCoverImage SourcePath="{Binding CoverPath}"
                                                                                    Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DesktopTextBrush}" />
                                                        <TextBlock Text="{Binding MetadataLine}" FontSize="11"
                                                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding PlaytimeText}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding LastPlayedText}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Column="2" Background="{DynamicResource DesktopPanelBrush}"
                                BorderBrush="#303A49" BorderThickness="1,0,0,0">
                            <ScrollViewer>
                                <StackPanel Margin="26" Spacing="15">
                                    <Border Height="310" CornerRadius="10" Background="#222B37"
                                            ClipToBounds="True">
                                        <foundation:GameCoverImage SourcePath="{Binding SelectedGame.CoverPath}"
                                                                    Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedGame.Name}" FontSize="32"
                                               FontWeight="Bold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DesktopTextBrush}" />
                                    <TextBlock Text="{Binding SelectedGame.MetadataLine}"
                                               Foreground="{DynamicResource DesktopAccentBrush}" />
                                    <TextBlock Text="{Binding SelectedGame.SourceName}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedGame.CompletionStatusName}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedGame.UserScoreText}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedGame.CriticScoreText}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedGame.CommunityScoreText}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding SelectedGame.GenresText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.PlatformsText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.CategoriesText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.TagsText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.DevelopersText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.PublishersText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.FeaturesText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.SeriesText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.AgeRatingsText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.RegionsText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.LinksText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.GameActionsText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.RomsText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.InstallationDetailsText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.ScriptsText}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DesktopMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{Binding SelectedGame.PlaytimeText}"
                                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedGame.LastPlayedText}"
                                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedGame.DescriptionText}"
                                               TextWrapping="Wrap" LineHeight="23"
                                               Foreground="{DynamicResource DesktopTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                        <Button Classes="primary" Command="{Binding ActivateCommand}"
                                                Content="{DynamicResource LOCDesktopPlay}" />
                                        <Button Command="{Binding InstallCommand}"
                                                Content="{DynamicResource LOCDesktopInstall}" />
                                        <Button Command="{Binding UninstallCommand}"
                                                Content="{DynamicResource LOCDesktopUninstall}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="{DynamicResource LOCDesktopEdit}" Command="{Binding EditCommand}" />
                                        <Button Content="{DynamicResource LOCDesktopDownloadMetadata}"
                                                Command="{Binding OpenMetadataDownloadCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#0C1016" Padding="18,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                    </Border>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsNotificationsVisible}"
                          Background="#D9000000">
                        <Border Width="760" MaxHeight="680" Padding="30" CornerRadius="14"
                                Background="{DynamicResource DesktopPanelStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{DynamicResource LOCDesktopNotifications}" FontSize="30"
                                           FontWeight="Bold" Foreground="{DynamicResource DesktopTextBrush}" />
                                <ListBox MaxHeight="450" ItemsSource="{Binding Notifications}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="3" Padding="12" CornerRadius="7" Background="#263140">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Type}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource DesktopAccentBrush}" />
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource DesktopTextBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Command="{Binding CloseCommand}" Content="×" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Command="{Binding CloseOverlayCommand}" Content="Close" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsActionPickerVisible}"
                          Background="#D9000000">
                        <Border Width="620" Padding="30" CornerRadius="14"
                                Background="{DynamicResource DesktopPanelStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{DynamicResource LOCDesktopChooseAction}" FontSize="30"
                                           FontWeight="Bold" Foreground="{DynamicResource DesktopTextBrush}" />
                                <ListBox ItemsSource="{Binding ActionChoices}"
                                         SelectedItem="{Binding SelectedActionChoice, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="primary" Command="{Binding ConfirmActionChoiceCommand}"
                                            Content="Continue" />
                                    <Button Command="{Binding CloseOverlayCommand}" Content="Cancel" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding PluginSettings.IsVisible}"
                          Background="#E6000000">
                        <Border Width="760" MaxHeight="720" Padding="30" CornerRadius="14"
                                Background="{DynamicResource DesktopPanelStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource LOCDesktopPluginSettings}" FontSize="30"
                                               FontWeight="Bold" Foreground="{DynamicResource DesktopTextBrush}" />
                                    <TextBlock Text="{DynamicResource LOCDesktopPluginSettingsDescription}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                </StackPanel>

                                <ListBox Grid.Row="1" MaxHeight="470"
                                         ItemsSource="{Binding PluginSettings.Plugins}"
                                         SelectedItem="{Binding PluginSettings.SelectedPlugin, Mode=TwoWay}"
                                         IsEnabled="{Binding PluginSettings.CanConfigure}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="3" Padding="14" CornerRadius="7" Background="#263140">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DesktopTextBrush}" />
                                                        <TextBlock Text="{Binding PluginType}" FontSize="11"
                                                                   Foreground="{DynamicResource DesktopAccentBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SettingsState}" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="2" Spacing="9">
                                    <TextBlock Text="{Binding PluginSettings.StatusText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <TextBlock Text="{Binding PluginSettings.ErrorText}" TextWrapping="Wrap"
                                               Foreground="#FF7F7F" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="primary"
                                                Content="{DynamicResource LOCDesktopOpenPluginSettings}"
                                                Command="{Binding PluginSettings.OpenSelectedCommand}" />
                                        <Button Content="{DynamicResource LOCDesktopCancel}"
                                                Command="{Binding PluginSettings.CloseCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding InstalledGameImport.IsVisible}"
                          Background="#E6000000">
                        <Border Width="900" MaxHeight="800" Padding="30" CornerRadius="14"
                                Background="{DynamicResource DesktopPanelStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource LOCDesktopImportInstalled}" FontSize="30"
                                               FontWeight="Bold" Foreground="{DynamicResource DesktopTextBrush}" />
                                    <TextBlock Text="{Binding InstalledGameImport.ProgramSummary}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" MaxHeight="620">
                                    <StackPanel Spacing="15" IsEnabled="{Binding InstalledGameImport.CanConfigure}">
                                        <Button Classes="primary"
                                                HorizontalAlignment="Left"
                                                Content="{DynamicResource LOCDesktopDetectInstalled}"
                                                Command="{Binding InstalledGameImport.DetectInstalledCommand}" />

                                        <TextBlock Text="{DynamicResource LOCDesktopScanFolder}" Classes="sectionLabel" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding InstalledGameImport.FolderPath, Mode=TwoWay}"
                                                     Watermark="C:\Games" />
                                            <Button Grid.Column="1" Content="{DynamicResource LOCDesktopBrowse}"
                                                    Command="{Binding InstalledGameImport.BrowseFolderCommand}" />
                                            <Button Grid.Column="2" Content="{DynamicResource LOCDesktopScanFolder}"
                                                    Command="{Binding InstalledGameImport.ScanFolderCommand}" />
                                        </Grid>

                                        <TextBlock Text="{DynamicResource LOCDesktopAddExecutable}" Classes="sectionLabel" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding InstalledGameImport.ExecutablePath, Mode=TwoWay}"
                                                     Watermark="C:\Games\Game.exe" />
                                            <Button Grid.Column="1" Content="{DynamicResource LOCDesktopBrowse}"
                                                    Command="{Binding InstalledGameImport.BrowseExecutableCommand}" />
                                            <Button Grid.Column="2" Content="{DynamicResource LOCDesktopAddExecutable}"
                                                    Command="{Binding InstalledGameImport.AddExecutableCommand}" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="18">
                                            <CheckBox Content="{DynamicResource LOCDesktopHideImported}"
                                                      IsChecked="{Binding InstalledGameImport.HideImported, Mode=TwoWay}" />
                                            <CheckBox Content="{DynamicResource LOCDesktopSelectAll}"
                                                      IsChecked="{Binding InstalledGameImport.SelectAll, Mode=TwoWay}" />
                                        </StackPanel>
                                        <CheckBox Content="{DynamicResource LOCDesktopMetadataOnImport}"
                                                  IsChecked="{Binding InstalledGameImport.DownloadMetadataOnImport, Mode=TwoWay}" />

                                        <ListBox MaxHeight="330" ItemsSource="{Binding InstalledGameImport.Programs}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,5">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource DesktopTextBrush}" />
                                                                <TextBlock Text="{Binding DisplayPath}" FontSize="10"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource DesktopMutedBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding TypeName}" FontSize="10"
                                                                           Foreground="{DynamicResource DesktopAccentBrush}" />
                                                                <TextBlock Text="{Binding ImportState}" FontSize="10"
                                                                           Foreground="{DynamicResource DesktopMutedBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Spacing="9">
                                    <ProgressBar Minimum="0" Maximum="{Binding InstalledGameImport.ProgressTotal}"
                                                 Value="{Binding InstalledGameImport.ProgressValue}" Height="8" />
                                    <TextBlock Text="{Binding InstalledGameImport.ProgressText}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <TextBlock Text="{Binding InstalledGameImport.ErrorText}" TextWrapping="Wrap"
                                               Foreground="#FF7F7F" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="primary" Content="{DynamicResource LOCDesktopImportSelected}"
                                                IsVisible="{Binding InstalledGameImport.CanConfigure}"
                                                Command="{Binding InstalledGameImport.ImportCommand}" />
                                        <Button Content="{DynamicResource LOCDesktopImportCancel}"
                                                IsVisible="{Binding InstalledGameImport.IsRunning}"
                                                Command="{Binding InstalledGameImport.CancelCommand}" />
                                        <Button Content="{DynamicResource LOCDesktopCancel}"
                                                IsVisible="{Binding InstalledGameImport.CanConfigure}"
                                                Command="{Binding InstalledGameImport.CloseCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding LibrarySync.IsVisible}"
                          Background="#E6000000">
                        <Border Width="720" MaxHeight="720" Padding="30" CornerRadius="14"
                                Background="{DynamicResource DesktopPanelStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                                <TextBlock Text="{DynamicResource LOCDesktopUpdateLibraries}" FontSize="30"
                                           FontWeight="Bold" Foreground="{DynamicResource DesktopTextBrush}" />

                                <ScrollViewer Grid.Row="1" MaxHeight="520">
                                    <StackPanel Spacing="15" IsEnabled="{Binding LibrarySync.CanConfigure}">
                                        <TextBlock Text="{DynamicResource LOCDesktopLibraries}" Classes="sectionLabel" />
                                        <ListBox MaxHeight="190" ItemsSource="{Binding LibrarySync.Libraries}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,4">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource DesktopTextBrush}" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource DesktopMutedBrush}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="Saved emulated-game scanners" Classes="sectionLabel" />
                                        <ListBox MaxHeight="190" ItemsSource="{Binding LibrarySync.GameScanners}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,4">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource DesktopTextBrush}" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource DesktopMutedBrush}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{DynamicResource LOCDesktopPlaytimeImportMode}"
                                                   Classes="sectionLabel" />
                                        <ComboBox ItemsSource="{Binding LibrarySync.PlaytimeModes}"
                                                  SelectedItem="{Binding LibrarySync.PlaytimeMode, Mode=TwoWay}" />
                                        <CheckBox Content="{DynamicResource LOCDesktopMetadataOnImport}"
                                                  IsChecked="{Binding LibrarySync.DownloadMetadataOnImport, Mode=TwoWay}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Spacing="9">
                                    <ProgressBar Minimum="0" Maximum="{Binding LibrarySync.ProgressTotal}"
                                                 Value="{Binding LibrarySync.ProgressValue}" Height="8" />
                                    <TextBlock Text="{Binding LibrarySync.ProgressText}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <TextBlock Text="{Binding LibrarySync.ErrorText}" TextWrapping="Wrap"
                                               Foreground="#FF7F7F" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="primary" Content="{DynamicResource LOCDesktopUpdateStart}"
                                                IsVisible="{Binding LibrarySync.CanConfigure}"
                                                Command="{Binding LibrarySync.StartCommand}" />
                                        <Button Content="{DynamicResource LOCDesktopUpdateCancel}"
                                                IsVisible="{Binding LibrarySync.IsRunning}"
                                                Command="{Binding LibrarySync.CancelCommand}" />
                                        <Button Content="{DynamicResource LOCDesktopCancel}"
                                                IsVisible="{Binding LibrarySync.CanConfigure}"
                                                Command="{Binding LibrarySync.CloseCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsDialogVisible}"
                          Background="#E6000000">
                        <Border Width="680" Padding="30" CornerRadius="14"
                                Background="{DynamicResource DesktopPanelStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{Binding DialogCaption}" FontSize="30" FontWeight="Bold"
                                           TextWrapping="Wrap" Foreground="{DynamicResource DesktopTextBrush}" />
                                <TextBlock Text="{Binding DialogMessage}" FontSize="18" LineHeight="26"
                                           TextWrapping="Wrap" Foreground="{DynamicResource DesktopTextBrush}" />
                                <ListBox ItemsSource="{Binding DialogOptions}"
                                         SelectedItem="{Binding SelectedDialogOption, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="primary" Command="{Binding ConfirmDialogCommand}"
                                            Content="Confirm" />
                                    <Button Command="{Binding CancelDialogCommand}" Content="Cancel" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding MetadataDownload.IsVisible}"
                          Background="#E6000000">
                        <Border Width="860" MaxHeight="790" Padding="30" CornerRadius="14"
                                Background="{DynamicResource DesktopPanelStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource LOCDesktopDownloadMetadata}" FontSize="30"
                                               FontWeight="Bold" Foreground="{DynamicResource DesktopTextBrush}" />
                                    <TextBlock Text="{Binding MetadataDownload.TargetSummary}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" MaxHeight="610">
                                    <StackPanel Spacing="16" IsEnabled="{Binding MetadataDownload.CanConfigure}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{DynamicResource LOCDesktopMetadataScope}" Classes="sectionLabel" />
                                            <ComboBox ItemsSource="{Binding MetadataDownload.Targets}"
                                                      SelectedItem="{Binding MetadataDownload.SelectedTarget, Mode=TwoWay}" />
                                        </StackPanel>
                                        <CheckBox Content="{DynamicResource LOCDesktopMetadataKeepExisting}"
                                                  IsChecked="{Binding MetadataDownload.SkipExistingValues, Mode=TwoWay}" />
                                        <CheckBox Content="{DynamicResource LOCDesktopMetadataDownloadBackgrounds}"
                                                  IsChecked="{Binding MetadataDownload.DownloadBackgroundsImmediately, Mode=TwoWay}" />

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="{DynamicResource LOCDesktopMetadataSources}"
                                                           Classes="sectionLabel" />
                                                <ListBox MaxHeight="245" ItemsSource="{Binding MetadataDownload.Sources}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,4">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource DesktopTextBrush}" />
                                                                    <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="7">
                                                <TextBlock Text="{DynamicResource LOCDesktopMetadataFields}"
                                                           Classes="sectionLabel" />
                                                <ListBox MaxHeight="245" ItemsSource="{Binding MetadataDownload.Fields}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Margin="2,3" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Spacing="9">
                                    <ProgressBar Minimum="0" Maximum="{Binding MetadataDownload.ProgressTotal}"
                                                 Value="{Binding MetadataDownload.ProgressValue}" Height="8" />
                                    <TextBlock Text="{Binding MetadataDownload.ProgressText}"
                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                    <TextBlock Text="{Binding MetadataDownload.ErrorText}" TextWrapping="Wrap"
                                               Foreground="#FF7F7F" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="primary" Content="{DynamicResource LOCDesktopMetadataStart}"
                                                IsVisible="{Binding MetadataDownload.CanConfigure}"
                                                Command="{Binding MetadataDownload.DownloadCommand}" />
                                        <Button Content="{DynamicResource LOCDesktopMetadataCancelDownload}"
                                                IsVisible="{Binding MetadataDownload.IsRunning}"
                                                Command="{Binding MetadataDownload.CancelCommand}" />
                                        <Button Content="{DynamicResource LOCDesktopCancel}"
                                                IsVisible="{Binding MetadataDownload.CanConfigure}"
                                                Command="{Binding MetadataDownload.CloseCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding Editor.IsVisible}"
                          Background="#E6000000">
                        <Border Width="920" MaxHeight="820" Padding="30" CornerRadius="14"
                                Background="{DynamicResource DesktopPanelStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                                <TextBlock Text="{Binding Editor.Title}" FontSize="30"
                                           FontWeight="Bold" Foreground="{DynamicResource DesktopTextBrush}" />
                                <ScrollViewer Grid.Row="1" MaxHeight="650">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16"
                                              IsVisible="{Binding Editor.IsSingleEdit}">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{DynamicResource LOCDesktopName}" Classes="sectionLabel" />
                                                <TextBox Text="{Binding Editor.Name, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock Text="{DynamicResource LOCDesktopSortingName}" Classes="sectionLabel" />
                                                <TextBox Text="{Binding Editor.SortingName, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopReleaseDate}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyReleaseDate, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <TextBox Text="{Binding Editor.ReleaseDate, Mode=TwoWay}"
                                                         IsEnabled="{Binding Editor.CanEditReleaseDate}"
                                                         Watermark="YYYY, YYYY-M, or YYYY-M-D" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopUserScore}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyUserScore, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <TextBox Text="{Binding Editor.UserScore, Mode=TwoWay}"
                                                         IsEnabled="{Binding Editor.CanEditUserScore}"
                                                         Watermark="0–100" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopSource}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplySource, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding Editor.Sources}"
                                                          IsEnabled="{Binding Editor.CanEditSource}"
                                                          SelectedItem="{Binding Editor.SelectedSource, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopCompletionStatus}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyCompletionStatus, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding Editor.CompletionStatuses}"
                                                          IsEnabled="{Binding Editor.CanEditCompletionStatus}"
                                                          SelectedItem="{Binding Editor.SelectedCompletionStatus, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopCriticScore}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyCriticScore, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <TextBox Text="{Binding Editor.CriticScore, Mode=TwoWay}"
                                                         IsEnabled="{Binding Editor.CanEditCriticScore}" Watermark="0–100" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopCommunityScore}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyCommunityScore, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <TextBox Text="{Binding Editor.CommunityScore, Mode=TwoWay}"
                                                         IsEnabled="{Binding Editor.CanEditCommunityScore}" Watermark="0–100" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopGenres}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyGenres, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.Genres}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditGenres}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopPlatforms}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyPlatforms, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.Platforms}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditPlatforms}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopCategories}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyCategories, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.Categories}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditCategories}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopTags}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyTags, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.Tags}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditTags}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopDevelopers}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyDevelopers, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.Developers}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditDevelopers}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopPublishers}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyPublishers, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.Publishers}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditPublishers}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopFeatures}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyFeatures, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.Features}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditFeatures}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopSeries}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplySeries, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.Series}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditSeries}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopAgeRatings}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyAgeRatings, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.AgeRatings}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditAgeRatings}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{DynamicResource LOCDesktopRegions}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyRegions, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <ListBox ItemsSource="{Binding Editor.Regions}" MaxHeight="110"
                                                         IsEnabled="{Binding Editor.CanEditRegions}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{DynamicResource LOCDesktopCoverImage}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyCoverImage, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <Border Height="100" Background="#222B37" CornerRadius="5" ClipToBounds="True">
                                                    <foundation:GameCoverImage SourcePath="{Binding Editor.CoverPreviewPath}"
                                                                                Stretch="UniformToFill" />
                                                </Border>
                                                <TextBox Text="{Binding Editor.CoverImage, Mode=TwoWay}"
                                                         IsEnabled="{Binding Editor.CanEditCoverImage}"
                                                         Watermark="{DynamicResource LOCDesktopLocalImagePath}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{DynamicResource LOCDesktopBackgroundImage}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyBackgroundImage, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <Border Height="100" Background="#222B37" CornerRadius="5" ClipToBounds="True">
                                                    <foundation:GameCoverImage SourcePath="{Binding Editor.BackgroundPreviewPath}"
                                                                                Stretch="UniformToFill" />
                                                </Border>
                                                <TextBox Text="{Binding Editor.BackgroundImage, Mode=TwoWay}"
                                                         IsEnabled="{Binding Editor.CanEditBackgroundImage}"
                                                         Watermark="{DynamicResource LOCDesktopLocalOrHttpsImagePath}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{DynamicResource LOCDesktopIcon}" Classes="sectionLabel" />
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyIcon, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                </StackPanel>
                                                <Border Height="100" Background="#222B37" CornerRadius="5" ClipToBounds="True">
                                                    <foundation:GameCoverImage SourcePath="{Binding Editor.IconPreviewPath}"
                                                                                Stretch="Uniform" />
                                                </Border>
                                                <TextBox Text="{Binding Editor.Icon, Mode=TwoWay}"
                                                         IsEnabled="{Binding Editor.CanEditIcon}"
                                                         Watermark="{DynamicResource LOCDesktopLocalImagePath}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{DynamicResource LOCDesktopLinks}" Classes="sectionLabel" />
                                                <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                          IsChecked="{Binding Editor.ApplyLinks, Mode=TwoWay}"
                                                          Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                            </StackPanel>
                                            <ListBox ItemsSource="{Binding Editor.Links}" MaxHeight="180"
                                                     IsEnabled="{Binding Editor.CanEditLinks}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="8" Margin="0,2">
                                                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                                                     Watermark="{DynamicResource LOCDesktopLinkName}" />
                                                            <TextBox Grid.Column="1" Text="{Binding Url, Mode=TwoWay}"
                                                                     Watermark="{DynamicResource LOCDesktopLinkUrl}" />
                                                            <Button Grid.Column="2" Command="{Binding RemoveCommand}" Content="×" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Command="{Binding Editor.AddLinkCommand}"
                                                    Content="{DynamicResource LOCDesktopAddLink}"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{DynamicResource LOCDesktopRoms}" Classes="sectionLabel" />
                                                <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                          IsChecked="{Binding Editor.ApplyRoms, Mode=TwoWay}"
                                                          Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                            </StackPanel>
                                            <ListBox ItemsSource="{Binding Editor.Roms}" MaxHeight="180"
                                                     IsEnabled="{Binding Editor.CanEditRoms}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,2*,Auto,Auto,Auto" ColumnSpacing="7" Margin="0,2">
                                                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                                                     Watermark="{DynamicResource LOCDesktopRomName}" />
                                                            <TextBox Grid.Column="1" Text="{Binding Path, Mode=TwoWay}"
                                                                     Watermark="{DynamicResource LOCDesktopRomPath}" />
                                                            <Button Grid.Column="2" Command="{Binding MoveUpCommand}" Content="↑" />
                                                            <Button Grid.Column="3" Command="{Binding MoveDownCommand}" Content="↓" />
                                                            <Button Grid.Column="4" Command="{Binding RemoveCommand}" Content="×" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Command="{Binding Editor.AddRomCommand}"
                                                    Content="{DynamicResource LOCDesktopAddRom}"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{DynamicResource LOCDesktopGameActions}" Classes="sectionLabel" />
                                                <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                          IsChecked="{Binding Editor.ApplyGameActions, Mode=TwoWay}"
                                                          Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                          IsChecked="{Binding Editor.ApplyIncludeLibraryPluginAction, Mode=TwoWay}"
                                                          Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                <CheckBox IsEnabled="{Binding Editor.CanEditIncludeLibraryPluginAction}"
                                                          IsChecked="{Binding Editor.IncludeLibraryPluginAction, Mode=TwoWay}"
                                                          Content="{DynamicResource LOCDesktopIncludeLibraryAction}" />
                                            </StackPanel>
                                            <ListBox ItemsSource="{Binding Editor.GameActions}" MaxHeight="480"
                                                     IsEnabled="{Binding Editor.CanEditGameActions}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#394657" BorderThickness="1" CornerRadius="7"
                                                                Padding="10" Margin="0,3">
                                                            <StackPanel Spacing="8">
                                                                <Grid ColumnDefinitions="2*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="7">
                                                                    <TextBox Text="{Binding Name, Mode=TwoWay}"
                                                                             Watermark="{DynamicResource LOCDesktopActionName}" />
                                                                    <ComboBox Grid.Column="1" Width="125"
                                                                              ItemsSource="{Binding Types}"
                                                                              SelectedItem="{Binding Type, Mode=TwoWay}" />
                                                                    <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                                                              IsChecked="{Binding IsPlayAction, Mode=TwoWay}"
                                                                              Content="{DynamicResource LOCDesktopPlayAction}" />
                                                                    <Button Grid.Column="3" Command="{Binding MoveUpCommand}" Content="↑" />
                                                                    <Button Grid.Column="4" Command="{Binding MoveDownCommand}" Content="↓" />
                                                                    <Button Grid.Column="5" Command="{Binding RemoveCommand}" Content="×" />
                                                                </Grid>
                                                                <StackPanel IsVisible="{Binding ShowPath}" Spacing="3">
                                                                    <TextBlock Text="{DynamicResource LOCDesktopPath}" FontSize="11"
                                                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                    <TextBox Text="{Binding Path, Mode=TwoWay}" />
                                                                </StackPanel>
                                                                <Grid IsVisible="{Binding IsFileAction}"
                                                                      ColumnDefinitions="*,*" ColumnSpacing="10">
                                                                    <StackPanel Spacing="3">
                                                                        <TextBlock Text="{DynamicResource LOCDesktopArguments}" FontSize="11"
                                                                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                        <TextBox Text="{Binding Arguments, Mode=TwoWay}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                                        <TextBlock Text="{DynamicResource LOCDesktopWorkingDirectory}" FontSize="11"
                                                                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                        <TextBox Text="{Binding WorkingDir, Mode=TwoWay}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel IsVisible="{Binding IsEmulatorAction}" Spacing="7">
                                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                                        <StackPanel Spacing="3">
                                                                            <TextBlock Text="{DynamicResource LOCDesktopEmulator}" FontSize="11"
                                                                                       Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                            <ComboBox ItemsSource="{Binding Emulators}"
                                                                                      SelectedItem="{Binding SelectedEmulator, Mode=TwoWay}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                                            <TextBlock Text="{DynamicResource LOCDesktopEmulatorProfile}" FontSize="11"
                                                                                       Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                            <ComboBox ItemsSource="{Binding EmulatorProfiles}"
                                                                                      SelectedItem="{Binding SelectedEmulatorProfile, Mode=TwoWay}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <CheckBox IsChecked="{Binding OverrideDefaultArgs, Mode=TwoWay}"
                                                                              Content="{DynamicResource LOCDesktopOverrideArguments}" />
                                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                                        <StackPanel Spacing="3">
                                                                            <TextBlock Text="{DynamicResource LOCDesktopArguments}" FontSize="11"
                                                                                       Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                            <TextBox Text="{Binding Arguments, Mode=TwoWay}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                                            <TextBlock Text="{DynamicResource LOCDesktopAdditionalArguments}" FontSize="11"
                                                                                       Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                            <TextBox Text="{Binding AdditionalArguments, Mode=TwoWay}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>
                                                                <StackPanel IsVisible="{Binding IsScriptAction}" Spacing="3">
                                                                    <TextBlock Text="{DynamicResource LOCDesktopScript}" FontSize="11"
                                                                               Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                    <TextBox Text="{Binding Script, Mode=TwoWay}" AcceptsReturn="True"
                                                                             FontFamily="Consolas" MinHeight="90" />
                                                                </StackPanel>
                                                                <StackPanel IsVisible="{Binding ShowTracking}" Spacing="7">
                                                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                                        <StackPanel Spacing="3">
                                                                            <TextBlock Text="{DynamicResource LOCDesktopTrackingMode}" FontSize="11"
                                                                                       Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                            <ComboBox ItemsSource="{Binding TrackingModes}"
                                                                                      SelectedItem="{Binding TrackingMode, Mode=TwoWay}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                                            <TextBlock Text="{DynamicResource LOCDesktopTrackingDelay}" FontSize="11"
                                                                                       Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                            <NumericUpDown Value="{Binding InitialTrackingDelay, Mode=TwoWay}"
                                                                                           Minimum="0" Increment="100" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Spacing="3">
                                                                            <TextBlock Text="{DynamicResource LOCDesktopTrackingFrequency}" FontSize="11"
                                                                                       Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                            <NumericUpDown Value="{Binding TrackingFrequency, Mode=TwoWay}"
                                                                                           Minimum="0" Increment="100" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <StackPanel IsVisible="{Binding ShowTrackingPath}" Spacing="3">
                                                                        <TextBlock Text="{DynamicResource LOCDesktopTrackingPath}" FontSize="11"
                                                                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                                                                        <TextBox Text="{Binding TrackingPath, Mode=TwoWay}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Command="{Binding Editor.AddGameActionCommand}"
                                                    Content="{DynamicResource LOCDesktopAddAction}"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{DynamicResource LOCDesktopInstallationRuntime}" Classes="sectionLabel" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                <StackPanel Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopInstallDirectory}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyInstallDirectory, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Editor.InstallDirectory, Mode=TwoWay}"
                                                             IsEnabled="{Binding Editor.CanEditInstallDirectory}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopVersion}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyVersion, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Editor.Version, Mode=TwoWay}"
                                                             IsEnabled="{Binding Editor.CanEditVersion}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                <StackPanel Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopManual}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyManual, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Editor.Manual, Mode=TwoWay}"
                                                             IsEnabled="{Binding Editor.CanEditManual}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopInstallSize}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyInstallSize, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Editor.InstallSize, Mode=TwoWay}"
                                                             IsEnabled="{Binding Editor.CanEditInstallSize}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                <StackPanel Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopLastPlayed}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyLastActivity, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <CalendarDatePicker SelectedDate="{Binding Editor.LastActivity, Mode=TwoWay}"
                                                                        IsEnabled="{Binding Editor.CanEditLastActivity}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopAdded}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyAdded, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <CalendarDatePicker SelectedDate="{Binding Editor.Added, Mode=TwoWay}"
                                                                        IsEnabled="{Binding Editor.CanEditAdded}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                <StackPanel Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopPlaytimeSeconds}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyPlaytime, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Editor.PlaytimeSeconds, Mode=TwoWay}"
                                                             IsEnabled="{Binding Editor.CanEditPlaytime}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopPlayCount}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyPlayCount, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Editor.PlayCount, Mode=TwoWay}"
                                                             IsEnabled="{Binding Editor.CanEditPlayCount}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                                <StackPanel Spacing="5">
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyIsInstalled, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    <CheckBox IsChecked="{Binding Editor.IsInstalled, Mode=TwoWay}"
                                                              IsEnabled="{Binding Editor.CanEditIsInstalled}"
                                                              Content="{DynamicResource LOCDesktopIsInstalled}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyOverrideInstallState, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    <CheckBox IsChecked="{Binding Editor.OverrideInstallState, Mode=TwoWay}"
                                                              IsEnabled="{Binding Editor.CanEditOverrideInstallState}"
                                                              Content="{DynamicResource LOCDesktopOverrideInstallState}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="5">
                                                    <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                              IsChecked="{Binding Editor.ApplyEnableSystemHdr, Mode=TwoWay}"
                                                              Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    <CheckBox IsChecked="{Binding Editor.EnableSystemHdr, Mode=TwoWay}"
                                                              IsEnabled="{Binding Editor.CanEditEnableSystemHdr}"
                                                              Content="{DynamicResource LOCDesktopEnableHdr}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{DynamicResource LOCDesktopScripts}" Classes="sectionLabel" />
                                            <Border BorderBrush="#394657" BorderThickness="1" CornerRadius="7" Padding="10">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopPreScript}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyPreScript, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Editor.PreScript, Mode=TwoWay}"
                                                             IsEnabled="{Binding Editor.CanEditPreScript}"
                                                             AcceptsReturn="True" FontFamily="Consolas" MinHeight="80" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyUseGlobalPreScript, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                        <CheckBox IsChecked="{Binding Editor.UseGlobalPreScript, Mode=TwoWay}"
                                                                  IsEnabled="{Binding Editor.CanEditUseGlobalPreScript}"
                                                                  Content="{DynamicResource LOCDesktopUseGlobalScript}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="#394657" BorderThickness="1" CornerRadius="7" Padding="10">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopGameStartedScript}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyGameStartedScript, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Editor.GameStartedScript, Mode=TwoWay}"
                                                             IsEnabled="{Binding Editor.CanEditGameStartedScript}"
                                                             AcceptsReturn="True" FontFamily="Consolas" MinHeight="80" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyUseGlobalGameStartedScript, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                        <CheckBox IsChecked="{Binding Editor.UseGlobalGameStartedScript, Mode=TwoWay}"
                                                                  IsEnabled="{Binding Editor.CanEditUseGlobalGameStartedScript}"
                                                                  Content="{DynamicResource LOCDesktopUseGlobalScript}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="#394657" BorderThickness="1" CornerRadius="7" Padding="10">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{DynamicResource LOCDesktopPostScript}" Classes="sectionLabel" />
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyPostScript, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Editor.PostScript, Mode=TwoWay}"
                                                             IsEnabled="{Binding Editor.CanEditPostScript}"
                                                             AcceptsReturn="True" FontFamily="Consolas" MinHeight="80" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                                  IsChecked="{Binding Editor.ApplyUseGlobalPostScript, Mode=TwoWay}"
                                                                  Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                        <CheckBox IsChecked="{Binding Editor.UseGlobalPostScript, Mode=TwoWay}"
                                                                  IsEnabled="{Binding Editor.CanEditUseGlobalPostScript}"
                                                                  Content="{DynamicResource LOCDesktopUseGlobalScript}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{DynamicResource LOCDesktopDescription}" Classes="sectionLabel" />
                                                <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                          IsChecked="{Binding Editor.ApplyDescription, Mode=TwoWay}"
                                                          Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                            </StackPanel>
                                            <TextBox Text="{Binding Editor.Description, Mode=TwoWay}"
                                                     IsEnabled="{Binding Editor.CanEditDescription}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                                        </StackPanel>
                                        <StackPanel Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{DynamicResource LOCDesktopNotes}" Classes="sectionLabel" />
                                                <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                          IsChecked="{Binding Editor.ApplyNotes, Mode=TwoWay}"
                                                          Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                            </StackPanel>
                                            <TextBox Text="{Binding Editor.Notes, Mode=TwoWay}"
                                                     IsEnabled="{Binding Editor.CanEditNotes}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                          IsChecked="{Binding Editor.ApplyFavorite, Mode=TwoWay}"
                                                          Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                <CheckBox Content="{DynamicResource LOCDesktopFavorite}"
                                                          IsEnabled="{Binding Editor.CanEditFavorite}"
                                                          IsChecked="{Binding Editor.Favorite, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <CheckBox IsVisible="{Binding Editor.IsBulkEdit}"
                                                          IsChecked="{Binding Editor.ApplyHidden, Mode=TwoWay}"
                                                          Content="{DynamicResource LOCDesktopApplyInBulk}" />
                                                <CheckBox Content="{DynamicResource LOCDesktopHidden}"
                                                          IsEnabled="{Binding Editor.CanEditHidden}"
                                                          IsChecked="{Binding Editor.Hidden, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border IsVisible="{Binding Editor.HasValidationError}"
                                                Background="#42D84A4A" BorderBrush="#E45A5A"
                                                BorderThickness="1" CornerRadius="6" Padding="10">
                                            <TextBlock Text="{Binding Editor.ValidationMessage}" TextWrapping="Wrap"
                                                       Foreground="#FFB6B6" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                    <Button Classes="primary" Command="{Binding Editor.SaveCommand}"
                                            Content="{DynamicResource LOCDesktopSave}" />
                                    <Button Command="{Binding Editor.CancelCommand}"
                                            Content="{DynamicResource LOCDesktopCancel}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
