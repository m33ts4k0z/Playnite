<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:foundation="using:Playnite.Avalonia.Controls">
    <DataTemplate x:Key="DesktopListItemTemplate">
        <StackPanel>
            <Button IsVisible="{Binding ShowGroupHeader}" Command="{Binding ToggleGroupCommand}"
                    Margin="4,14,4,4" Padding="10,5"
                    Background="Transparent"
                    HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding GroupHeader}" FontWeight="Bold"
                           Foreground="{DynamicResource DesktopAccentBrush}" />
            </Button>
            <Border Classes="desktopRow" Padding="10,8"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DesktopBorderBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding IsGroupExpanded}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="{Binding ListIconWidth}" Height="{Binding ListIconHeight}" Background="{DynamicResource DesktopSurfaceRaisedBrush}"
                            CornerRadius="4" ClipToBounds="True"
                            IsVisible="{Binding ShowListIcon}">
                        <foundation:GameCoverImage SourcePath="{Binding CoverPath}"
                                                   Stretch="{Binding CoverArtStretch}" />
                    </Border>
                    <TextBlock Grid.Column="1" Name="PART_GameTitle"
                               Text="{Binding Name}" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource DesktopTextBrush}" />
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
