<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="DesktopFilterPanelTemplate">
        <Border Width="940" MaxHeight="820" Padding="28" CornerRadius="14"
                Background="{DynamicResource DesktopPanelStrongBrush}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="15">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Filters" FontSize="30" FontWeight="Bold"
                                   Foreground="{DynamicResource DesktopTextBrush}" />
                        <TextBlock Text="{Binding FilterActiveIndicator}"
                                   Foreground="{DynamicResource DesktopAccentBrush}" />
                        <TextBlock Text="{Binding FilterMatchSummary}" FontSize="11"
                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" FontSize="22"
                            Command="{Binding CloseFilterPanelCommand}" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding FilterPresets}"
                              SelectedItem="{Binding SelectedFilterPreset, Mode=TwoWay}" />
                    <Button Grid.Column="1" Classes="primary" Content="Save preset"
                            Command="{Binding SaveFilterPresetCommand}" />
                    <Button Grid.Column="2" Content="Rename"
                            Command="{Binding RenameFilterPresetCommand}" />
                    <Button Grid.Column="3" Content="Delete"
                            Command="{Binding DeleteFilterPresetCommand}" />
                </Grid>

                <ScrollViewer Grid.Row="2" MaxHeight="620">
                    <StackPanel Spacing="12">
                        <Border Background="{DynamicResource DesktopPanelBrush}"
                                CornerRadius="8" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Matching" Classes="sectionLabel" />
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox Margin="0,0,18,6" Content="{Binding InstalledFilterLabel}"
                                              IsChecked="{Binding FilterInstalled, Mode=TwoWay}" />
                                    <CheckBox Margin="0,0,18,6" Content="{Binding UninstalledFilterLabel}"
                                              IsChecked="{Binding FilterUninstalled, Mode=TwoWay}" />
                                    <CheckBox Margin="0,0,18,6" Content="{Binding HiddenFilterLabel}"
                                              IsChecked="{Binding FilterHidden, Mode=TwoWay}" />
                                    <CheckBox Margin="0,0,18,6" Content="{Binding FavoriteFilterLabel}"
                                              IsChecked="{Binding FilterFavorite, Mode=TwoWay}" />
                                    <CheckBox Margin="0,0,18,6" Content="Require every selected value (AND)"
                                              IsChecked="{Binding FilterUseAndStyle, Mode=TwoWay}" />
                                </WrapPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Name" Classes="sectionLabel" />
                                        <TextBox Text="{Binding FilterName, Mode=TwoWay}"
                                                 Watermark="Game name contains…" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Version" Classes="sectionLabel" />
                                        <TextBox Text="{Binding FilterVersion, Mode=TwoWay}"
                                                 Watermark="Version contains…" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FilterGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding DisplayTitle}"
                                              Margin="0,2"
                                              Padding="0"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource DesktopPanelBrush}"
                                              BorderBrush="{DynamicResource DesktopBorderBrush}">
                                        <Border Background="{DynamicResource DesktopPanelBrush}"
                                                CornerRadius="0,0,8,8" Padding="12">
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding DisplayText}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Margin="0,0,18,8" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Text="Changes apply immediately. Counts come from the active Core library."
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DesktopMutedBrush}" />
                    <Button Grid.Column="1" Content="Clear all"
                            Command="{Binding ClearFiltersCommand}" />
                    <Button Grid.Column="2" Classes="primary" Content="Done"
                            Command="{Binding CloseFilterPanelCommand}" />
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>
</ResourceDictionary>
