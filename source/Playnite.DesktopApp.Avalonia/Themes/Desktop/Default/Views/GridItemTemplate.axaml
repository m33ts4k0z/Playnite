<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:foundation="using:Playnite.Avalonia.Controls">
    <DataTemplate x:Key="DesktopGridItemTemplate">
        <StackPanel>
        <Button IsVisible="{Binding ShowGroupHeader}" Command="{Binding ToggleGroupCommand}"
                HorizontalContentAlignment="Stretch" Margin="4,6" Padding="8,4">
            <TextBlock Text="{Binding GroupHeader}" FontSize="{DynamicResource DesktopFontSizeSmall}"
                       FontWeight="Bold" Foreground="{DynamicResource DesktopAccentBrush}" />
        </Button>
        <Border Classes="desktopTile" Margin="{Binding GridItemMargin}" CornerRadius="8"
                Background="Transparent" Opacity="{Binding GridItemOpacity}"
                BorderBrush="Transparent" BorderThickness="2"
                ClipToBounds="True" IsVisible="{Binding IsGroupExpanded}">
            <Grid RowDefinitions="*,Auto">
                <Border Grid.RowSpan="2" Background="{DynamicResource DesktopPanelBrush}"
                        IsVisible="{Binding ShowGridItemBackground}" />
                <Border Background="#222B37">
                    <Grid>
                        <TextBlock Text="{Binding Name}" Margin="14"
                                   FontSize="{DynamicResource DesktopFontSizeLarger}" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="#536579"
                                   IsVisible="{Binding ShowEmptyCoverName}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <foundation:GameCoverImage SourcePath="{Binding CoverPath}"
                                                   Stretch="{Binding CoverArtStretch}" />
                        <Border IsVisible="{Binding Favorite}" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Padding="7,3"
                                Background="#D900A8E8" CornerRadius="6,0,0,0">
                            <TextBlock Text="★" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="11,8" Spacing="2"
                            IsVisible="{Binding ShowNamesUnderCovers}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DesktopTextBrush}" />
                    <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource DesktopFontSizeSmall}"
                               Foreground="{DynamicResource DesktopMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
