<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="DesktopTopPanelTemplate">
        <Border Background="{DynamicResource DesktopPanelStrongBrush}"
                BorderBrush="#303A49" BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Menu Background="Transparent">
                        <MenuItem Header="☰">
                            <MenuItem Header="{DynamicResource LOCMenuAddGame}">
                                <MenuItem Header="{DynamicResource LOCMenuAddGameManual}" Command="{Binding AddManualGameCommand}" />
                                <MenuItem Header="Scan installed programs and Microsoft Store" Command="{Binding OpenInstalledGameImportCommand}" />
                                <MenuItem Header="Import emulated games" Command="{Binding OpenEmulatedImportCommand}" />
                            </MenuItem>
                            <MenuItem Header="{DynamicResource LOCLibrary}">
                                <MenuItem Header="{DynamicResource LOCCheckLibraryUpdates}" Command="{Binding OpenLibrarySyncCommand}" InputGesture="F5" />
                                <MenuItem Header="{DynamicResource LOCMenuDownloadMetadata}" Command="{Binding OpenMetadataDownloadCommand}" InputGesture="Ctrl+D" />
                                <MenuItem Header="{DynamicResource LOCLibraryManager}" Command="{Binding OpenDatabaseFieldsCommand}" InputGesture="Ctrl+W" />
                                <MenuItem Header="Database explorer" Command="{Binding OpenExplorerCommand}" InputGesture="Ctrl+E" />
                                <MenuItem Header="{DynamicResource LOCMenuBackupData}" Command="{Binding BackupDataCommand}" />
                                <MenuItem Header="{DynamicResource LOCMenuRestoreBackup}" Command="{Binding RestoreDataBackupCommand}" />
                            </MenuItem>
                            <MenuItem Header="{DynamicResource LOCMenuSelectRandomGame}" Command="{Binding SelectRandomGameCommand}" InputGesture="F6" />
                            <MenuItem Header="{DynamicResource LOCTopPanelViewSelectRandomGameButtonTooltip}" Command="{Binding SelectRandomFilteredGameCommand}" InputGesture="F7" />
                            <MenuItem Header="{DynamicResource LOCMenuAddons}" Command="{Binding OpenAddonStoreCommand}" InputGesture="F9" />
                            <MenuItem Header="{DynamicResource LOCMenuSoftwareTools}" Command="{Binding OpenToolsConfigCommand}" />
                            <MenuItem Header="{DynamicResource LOCMenuConfigureEmulatorsMenuTitle}" Command="{Binding OpenEmulatorConfigCommand}" InputGesture="Ctrl+T" />
                            <MenuItem Header="{DynamicResource LOCExtensions}" Command="{Binding OpenPluginMainMenuCommand}" />
                            <MenuItem Header="{DynamicResource LOCReloadScripts}" Command="{Binding ReloadScriptsCommand}" InputGesture="F12" />
                            <MenuItem Header="{DynamicResource LOCStartInteractivePowerShell}" Command="{Binding OpenInteractivePowerShellCommand}" />
                            <MenuItem Header="{DynamicResource LOCMenuPlayniteSettingsTitle}" Command="{Binding OpenSettingsCommand}" InputGesture="F4" />
                            <MenuItem Header="{DynamicResource LOCMenuHelpTitle}" Command="{Binding OpenHelpCommand}" />
                            <MenuItem Header="{DynamicResource LOCMenuAbout}" Command="{Binding OpenAboutCommand}" InputGesture="F1" />
                            <MenuItem Header="{DynamicResource LOCCrashRestartPlaynite}" Command="{Binding RestartCommand}" />
                            <MenuItem Header="{DynamicResource LOCCrashRestartSafe}" Command="{Binding RestartSafeModeCommand}" />
                            <MenuItem Header="{DynamicResource LOCExitAppLabel}" Command="{Binding ExitApplicationCommand}" InputGesture="Alt+Q" />
                        </MenuItem>
                    </Menu>
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource DesktopAccentBrush}">
                        <TextBlock Text="P" FontSize="{DynamicResource DesktopFontSizeLarger}" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Playnite" FontSize="{DynamicResource DesktopFontSizeLarger}" FontWeight="SemiBold"
                               Foreground="{DynamicResource DesktopTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="#263140" CornerRadius="12" Padding="9,4">
                        <TextBlock Text="Avalonia Desktop" FontSize="{DynamicResource DesktopFontSizeSmall}"
                                   Foreground="{DynamicResource DesktopAccentBrush}" />
                    </Border>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding PluginTopPanelItems}"
                              IsVisible="{Binding ShowPluginTopPanelItemsLeft}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Command}" IsVisible="{Binding Visible}" ToolTip.Tip="{Binding PluginName}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ContentPresenter Content="{Binding Icon}" MaxWidth="18" MaxHeight="18" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="3"
                            IsVisible="{Binding IsGlobalProgressVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding GlobalProgressText}" MaxWidth="400"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DesktopMutedBrush}" />
                        <Button Content="{DynamicResource LOCCancelLabel}" Command="{Binding CancelGlobalProgressCommand}"
                                IsVisible="{Binding CanCancelGlobalProgress}" />
                    </StackPanel>
                    <ProgressBar Width="360" Height="5"
                                 Minimum="0" Maximum="{Binding GlobalProgressMaximum}"
                                 Value="{Binding GlobalProgressValue}"
                                 IsIndeterminate="{Binding IsGlobalProgressIndeterminate}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding PluginTopPanelItems}"
                                  IsVisible="{Binding ShowPluginTopPanelItemsRight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding Command}" IsVisible="{Binding Visible}"
                                        ToolTip.Tip="{Binding PluginName}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ContentPresenter Content="{Binding Icon}" MaxWidth="18" MaxHeight="18" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding FilterActiveIndicator}"
                            Command="{Binding ToggleFilterPanelCommand}"
                            IsVisible="{Binding ShowFilterStatusInTopPanel}" />
                    <Button Content="{DynamicResource LOCUpdaterWindowTitle}"
                            Command="{Binding InstallProgramUpdateCommand}"
                            IsVisible="{Binding HasProgramUpdate}" />
                    <TextBlock Text="{Binding LibrarySummary}" VerticalAlignment="Center"
                               IsVisible="{Binding ShowLibrarySummaryInTopPanel}"
                               Foreground="{DynamicResource DesktopMutedBrush}" />
                    <Button Command="{Binding ToggleNotificationsCommand}"
                            IsVisible="{Binding ShowNotificationsInTopPanel}"
                            Content="{Binding NotificationCount, StringFormat='Notifications ({0})'}" />
                </StackPanel>
            </Grid>
        </Border>
    </ControlTemplate>
</ResourceDictionary>
