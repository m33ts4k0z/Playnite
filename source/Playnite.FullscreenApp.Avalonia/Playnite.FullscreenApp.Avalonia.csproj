<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>Playnite.FullscreenApp.Avalonia</RootNamespace>
    <AssemblyName>Playnite.FullscreenApp.Avalonia</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(TargetFramework)' != 'net10.0'">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationManifest Condition="'$(TargetFramework)' != 'net10.0'">app.manifest</ApplicationManifest>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Playnite.Avalonia.App\Playnite.Avalonia.App.csproj" Condition="'$(TargetFramework)' != 'net10.0'" />
    <ProjectReference Include="..\Playnite.Avalonia\Playnite.Avalonia.csproj" />
    <ProjectReference Include="..\Playnite.Core\Playnite.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="App.cs;MainWindow.cs;FullscreenPilotSelfTest.cs" />
    <Compile Remove="Controls\**\*.cs;Services\**\*.cs;ViewModels\**\*.cs;Views\**\*.cs" />
    <AvaloniaXaml Remove="Views\**\*.axaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="App.Portable.cs;MainWindow.Portable.cs;FullscreenLibrary.Portable.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Themes\**\*.axaml;Localization\**\*.axaml" />
    <AvaloniaXaml Remove="Themes\**\*.axaml;Localization\**\*.axaml" />
    <Content Include="Themes\**\*.axaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Themes\**\*.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Localization\**\*.axaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Playnite.DesktopApp.Avalonia\Localization\Languages\**\*.axaml"
             Link="Localization\Languages\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Playnite\gamecontrollerdb.txt" Link="gamecontrollerdb.txt" CopyToOutputDirectory="PreserveNewest" />
    <ContentWithTargetPath Include="..\..\references\x64\SDL2.dll" Condition="'$(TargetFramework)' != 'net10.0'" Link="Dependencies\SDL2.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2.dll" />
    <ContentWithTargetPath Include="..\..\references\x64\SDL2_mixer.dll" Condition="'$(TargetFramework)' != 'net10.0'" Link="Dependencies\SDL2_mixer.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2_mixer.dll" />
  </ItemGroup>

</Project>
