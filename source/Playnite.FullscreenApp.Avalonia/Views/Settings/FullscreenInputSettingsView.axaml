<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Playnite.FullscreenApp.Avalonia.ViewModels"
             x:Class="Playnite.FullscreenApp.Avalonia.Views.Settings.FullscreenInputSettingsView"
             x:DataType="vm:FullscreenInputSettingsSection">
    <StackPanel Spacing="18">
        <TextBlock Text="Input" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource FullscreenTextBrush}" />
        <CheckBox Content="{DynamicResource LOCFullscreenSwapButtons}"
                  IsChecked="{Binding SwapConfirmCancelButtons, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
