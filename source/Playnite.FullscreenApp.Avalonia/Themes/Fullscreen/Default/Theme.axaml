<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Playnite.FullscreenApp.Avalonia.Controls"
                    xmlns:foundation="using:Playnite.Avalonia.Controls">

    <SolidColorBrush x:Key="FullscreenBackgroundBrush" Color="#0B0E13" />
    <SolidColorBrush x:Key="FullscreenSurfaceBrush" Color="#D91A202A" />
    <SolidColorBrush x:Key="FullscreenSurfaceStrongBrush" Color="#F2232B37" />
    <SolidColorBrush x:Key="FullscreenAccentBrush" Color="#00A8E8" />
    <SolidColorBrush x:Key="FullscreenTextBrush" Color="#F7FAFC" />
    <SolidColorBrush x:Key="FullscreenMutedTextBrush" Color="#AAB6C4" />
    <SolidColorBrush x:Key="FullscreenTileBrush" Color="#202733" />
    <SolidColorBrush x:Key="FullscreenTileSelectedBrush" Color="#29465F" />
    <x:Double x:Key="FullscreenFontSize">22</x:Double>
    <x:Double x:Key="FullscreenFontSizeSmall">18</x:Double>

    <ControlTheme x:Key="{x:Type local:FullscreenMainView}"
                  TargetType="local:FullscreenMainView">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="{DynamicResource FullscreenBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="84" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="72" />
                    </Grid.RowDefinitions>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding ShowMainBackground}" ClipToBounds="True">
                        <foundation:GameCoverImage SourcePath="{Binding MainBackgroundPath}"
                                                   Stretch="UniformToFill"
                                                   Effect="{Binding MainBackgroundBlurEffect}" />
                        <Border Background="Black" Opacity="{Binding MainBackgroundDarkOpacity}" />
                    </Grid>

                    <Border Grid.Row="0"
                            Background="{DynamicResource FullscreenSurfaceBrush}"
                            Padding="42,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="12"
                                        Background="{DynamicResource FullscreenAccentBrush}">
                                    <TextBlock Text="P" FontSize="24" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Playnite" FontSize="28" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FullscreenTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BatteryText}" FontSize="18"
                                           IsVisible="{Binding ShowBattery}"
                                           Foreground="{DynamicResource FullscreenTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ClockText}" FontSize="20"
                                           IsVisible="{Binding ShowClock}"
                                           Foreground="{DynamicResource FullscreenTextBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCFullscreenLibrary}"
                                               Foreground="{DynamicResource FullscreenMutedTextBrush}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding LibrarySummary}" FontSize="20"
                                               Foreground="{DynamicResource FullscreenTextBrush}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox Name="PART_GameList"
                             Grid.Row="1"
                             Margin="34,28"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <foundation:UniformGridVirtualizingPanel ItemWidth="230" ItemHeight="318"
                                                                          Columns="{Binding Columns}"
                                                                          Rows="{Binding Rows}"
                                                                          ItemSpacing="{Binding ItemSpacing}"
                                                                          Orientation="{Binding LayoutOrientation}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="gameTile"
                                        Opacity="{Binding TileOpacity}"
                                        CornerRadius="9"
                                        Background="{DynamicResource FullscreenTileBrush}"
                                        BorderBrush="Transparent"
                                        BorderThickness="3"
                                        ClipToBounds="True">
                                    <Grid RowDefinitions="*,Auto">
                                        <Border Background="#151A22">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}"
                                                           Margin="18"
                                                           FontSize="34"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Foreground="#526173"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <foundation:GameCoverImage SourcePath="{Binding CoverPath}"
                                                                      Stretch="UniformToFill" />
                                                <Border IsVisible="{Binding Favorite}"
                                                        Background="#D900A8E8"
                                                        CornerRadius="0,0,0,8"
                                                        Padding="9,5"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="★" FontSize="18" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="14,11" Spacing="3">
                                            <TextBlock Text="{Binding Name}"
                                                       IsVisible="{Binding ShowTitle}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource FullscreenTextBrush}" />
                                            <TextBlock Text="{Binding ActivityText}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource FullscreenMutedTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            Background="{DynamicResource FullscreenSurfaceBrush}"
                            Padding="42,0">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{DynamicResource FullscreenMutedTextBrush}"
                                       FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="{Binding DetailsPromptGlyph}" FontWeight="Bold"
                                               Foreground="{DynamicResource FullscreenAccentBrush}"
                                               FontSize="{DynamicResource FullscreenFontSizeSmall}" />
                                    <TextBlock Text="{DynamicResource LOCFullscreenDetails}"
                                               Foreground="{DynamicResource FullscreenTextBrush}"
                                               FontSize="{DynamicResource FullscreenFontSizeSmall}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="{Binding PlayPromptGlyph}" FontWeight="Bold"
                                               Foreground="{DynamicResource FullscreenAccentBrush}"
                                               FontSize="{DynamicResource FullscreenFontSizeSmall}" />
                                    <TextBlock Text="{DynamicResource LOCFullscreenPlay}"
                                               Foreground="{DynamicResource FullscreenTextBrush}"
                                               FontSize="{DynamicResource FullscreenFontSizeSmall}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="☰" FontWeight="Bold"
                                               Foreground="{DynamicResource FullscreenAccentBrush}"
                                               FontSize="{DynamicResource FullscreenFontSizeSmall}" />
                                    <TextBlock Text="{DynamicResource LOCFullscreenMenu}"
                                               Foreground="{DynamicResource FullscreenTextBrush}"
                                               FontSize="{DynamicResource FullscreenFontSizeSmall}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsDetailsVisible}"
                          Background="#F20B0E13">
                        <Grid Margin="70" ColumnDefinitions="360,*" ColumnSpacing="54">
                            <Border CornerRadius="12" Background="#151A22" ClipToBounds="True">
                                <foundation:GameCoverImage SourcePath="{Binding SelectedGame.CoverPath}"
                                                      Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="18">
                                <TextBlock Text="{Binding SelectedGame.Name}"
                                           FontSize="52" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <TextBlock Text="{Binding SelectedGame.MetadataLine}"
                                           FontSize="20"
                                           Foreground="{DynamicResource FullscreenAccentBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="28">
                                    <TextBlock Text="{Binding SelectedGame.PlaytimeText}"
                                               Foreground="{DynamicResource FullscreenMutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedGame.LastPlayedText}"
                                               Foreground="{DynamicResource FullscreenMutedTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedGame.DescriptionText}"
                                           MaxHeight="230" FontSize="18" LineHeight="27"
                                           TextWrapping="Wrap" TextTrimming="WordEllipsis"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                                    <Button Name="PART_DetailsPrimaryButton" Classes="primary" Command="{Binding ActivateCommand}"
                                            Content="Play / Install" />
                                    <Button Command="{Binding UninstallCommand}"
                                            Content="{DynamicResource LOCFullscreenUninstall}" />
                                    <Button Command="{Binding BackCommand}"
                                            Content="{DynamicResource LOCFullscreenReturn}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsMenuVisible}"
                          Background="#B8000000">
                        <Border Width="440" Padding="38" CornerRadius="16"
                                Background="{DynamicResource FullscreenSurfaceStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Playnite" FontSize="36" FontWeight="Bold"
                                           Margin="0,0,0,12"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <Button Name="PART_MenuFirstButton" Classes="primary" Command="{Binding BackCommand}"
                                        Content="{DynamicResource LOCFullscreenReturn}" />
                                <Button Command="{Binding OpenSearchCommand}"
                                        Content="{DynamicResource LOCFullscreenSearch}" />
                                <Button Command="{Binding ToggleFiltersCommand}"
                                        Content="{DynamicResource LOCFullscreenFilters}" />
                                <Button Command="{Binding ToggleNotificationsCommand}"
                                        Content="{DynamicResource LOCFullscreenNotifications}" />
                                <Button Command="{Binding OpenSettingsCommand}"
                                        Content="{DynamicResource LOCFullscreenSettings}" />
                                <Button Command="{Binding ToggleFullscreenCommand}"
                                        Content="{DynamicResource LOCFullscreenToggleFullscreen}" />
                                <Button Command="{Binding ExitCommand}"
                                        Content="{DynamicResource LOCFullscreenExit}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsSearchVisible}"
                          Background="#D9000000">
                        <Border Width="760" Padding="38" CornerRadius="16"
                                Background="{DynamicResource FullscreenSurfaceStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="18">
                                <TextBlock Text="{DynamicResource LOCFullscreenSearch}"
                                           FontSize="36" FontWeight="Bold"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <TextBox Name="PART_SearchBox"
                                         Text="{Binding SearchText, Mode=TwoWay}"
                                         Watermark="Type a game name, platform, or genre"
                                         FontSize="24" Padding="16" />
                                <TextBlock Text="{Binding LibrarySummary}"
                                           Foreground="{DynamicResource FullscreenMutedTextBrush}" />
                                <Button Command="{Binding CloseSearchCommand}"
                                        Content="{DynamicResource LOCFullscreenReturn}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding PluginSearch.IsVisible}"
                          Background="#E6000000">
                        <Border Width="860" MaxHeight="760" Padding="38" CornerRadius="16"
                                Background="{DynamicResource FullscreenSurfaceStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="15">
                                <TextBlock Text="{Binding PluginSearch.Label, FallbackValue=Plugin search}"
                                           FontSize="36" FontWeight="Bold"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <TextBlock Grid.Row="1" Text="{Binding PluginSearch.Description}"
                                           FontSize="17" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FullscreenMutedTextBrush}" />
                                <TextBox Grid.Row="2" Name="PART_PluginSearchBox"
                                         Text="{Binding PluginSearch.SearchText, Mode=TwoWay}"
                                         Watermark="{Binding PluginSearch.Hint}"
                                         FontSize="23" Padding="16" />
                                <ListBox Grid.Row="3" MaxHeight="400"
                                         ItemsSource="{Binding PluginSearch.Results}"
                                         SelectedItem="{Binding PluginSearch.SelectedResult, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="3" Padding="14" CornerRadius="8" Background="#302D3748">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FullscreenTextBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="15"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource FullscreenMutedTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                                    <Button Classes="primary" Command="{Binding PluginSearch.PrimaryCommand}"
                                            Content="{Binding PluginSearch.PrimaryActionName}"
                                            IsVisible="{Binding PluginSearch.HasPrimaryAction}" />
                                    <Button Command="{Binding PluginSearch.SecondaryCommand}"
                                            Content="{Binding PluginSearch.SecondaryActionName}"
                                            IsVisible="{Binding PluginSearch.HasSecondaryAction}" />
                                    <Button Command="{Binding PluginSearch.MenuCommand}"
                                            Content="{Binding PluginSearch.MenuActionName}"
                                            IsVisible="{Binding PluginSearch.HasMenuAction}" />
                                    <Button Command="{Binding PluginSearch.BackCommand}" Content="Back"
                                            IsVisible="{Binding PluginSearch.CanGoBack}" />
                                    <Button Command="{Binding PluginSearch.CloseCommand}"
                                            Content="{DynamicResource LOCFullscreenReturn}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsFiltersVisible}"
                          Background="#D9000000">
                        <Border Width="600" Padding="38" CornerRadius="16"
                                Background="{DynamicResource FullscreenSurfaceStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="18">
                                <TextBlock Text="{DynamicResource LOCFullscreenFilters}"
                                           FontSize="36" FontWeight="Bold"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <ListBox Name="PART_FilterList"
                                         MaxHeight="420"
                                         ItemsSource="{Binding FilterOptions}"
                                         SelectedItem="{Binding SelectedFilterOption, Mode=TwoWay}" />
                                <Button Classes="primary" Command="{Binding ApplyFilterCommand}"
                                        Content="{DynamicResource LOCFullscreenApply}" />
                                <Button Command="{Binding BackCommand}"
                                        Content="{DynamicResource LOCFullscreenReturn}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding Settings.IsVisible}"
                          Background="#D9000000">
                        <Border Width="900" MaxHeight="720" Padding="38" CornerRadius="16"
                                Background="{DynamicResource FullscreenSurfaceStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="24">
                                <TextBlock Text="{DynamicResource LOCFullscreenSettings}"
                                           FontSize="36" FontWeight="Bold"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />

                                <Grid Grid.Row="1" ColumnDefinitions="220,*" ColumnSpacing="24">
                                    <ListBox Name="PART_SettingsSections"
                                             ItemsSource="{Binding Settings.Sections}"
                                             SelectedItem="{Binding Settings.SelectedSection, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}" Padding="8,12"
                                                           FontSize="20"
                                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <ContentControl Name="PART_SettingsContent" Grid.Column="1"
                                                    Content="{Binding Settings.SelectedSection.Content}" />
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <TextBlock Text="Restart required to apply this change."
                                               IsVisible="{Binding Settings.RestartRequired}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource FullscreenAccentBrush}" />
                                    <Button Grid.Column="1" Classes="primary"
                                            Command="{Binding Settings.SaveCommand}"
                                            Content="Save" />
                                    <Button Grid.Column="2" Command="{Binding Settings.CancelCommand}"
                                            Content="Cancel" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsNotificationsVisible}"
                          Background="#D9000000">
                        <Border Width="780" MaxHeight="720" Padding="38" CornerRadius="16"
                                Background="{DynamicResource FullscreenSurfaceStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="18">
                                <TextBlock Text="{DynamicResource LOCFullscreenNotifications}"
                                           FontSize="36" FontWeight="Bold"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <TextBlock Text="{Binding NotificationCount, StringFormat='{}{0} messages'}"
                                           Foreground="{DynamicResource FullscreenMutedTextBrush}" />
                                <ListBox Name="PART_NotificationsList"
                                         MaxHeight="450"
                                         ItemsSource="{Binding Notifications}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="3" Padding="14" CornerRadius="8" Background="#302D3748">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding Type}" FontWeight="Bold"
                                                               Foreground="{DynamicResource FullscreenAccentBrush}" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource FullscreenTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Command="{Binding BackCommand}"
                                        Content="{DynamicResource LOCFullscreenReturn}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsActionPickerVisible}"
                          Background="#D9000000">
                        <Border Width="650" Padding="38" CornerRadius="16"
                                Background="{DynamicResource FullscreenSurfaceStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="18">
                                <TextBlock Text="{DynamicResource LOCFullscreenChooseAction}"
                                           FontSize="36" FontWeight="Bold"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <ListBox Name="PART_ActionList"
                                         MaxHeight="420"
                                         ItemsSource="{Binding ActionChoices}"
                                         SelectedItem="{Binding SelectedActionChoice, Mode=TwoWay}" />
                                <Button Classes="primary" Command="{Binding ConfirmActionChoiceCommand}"
                                        Content="{DynamicResource LOCFullscreenPlay}" />
                                <Button Command="{Binding BackCommand}"
                                        Content="{DynamicResource LOCFullscreenReturn}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3" IsVisible="{Binding IsDialogVisible}"
                          Background="#E6000000">
                        <Border Width="700" Padding="38" CornerRadius="16"
                                Background="{DynamicResource FullscreenSurfaceStrongBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="18">
                                <TextBlock Text="{Binding DialogCaption}"
                                           FontSize="34" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <TextBlock Text="{Binding DialogMessage}"
                                           FontSize="20" LineHeight="29" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FullscreenTextBrush}" />
                                <ListBox Name="PART_DialogOptions"
                                         MaxHeight="320"
                                         ItemsSource="{Binding DialogOptions}"
                                         SelectedItem="{Binding SelectedDialogOption, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Classes="primary" Command="{Binding ConfirmDialogCommand}"
                                            Content="{DynamicResource LOCFullscreenConfirm}" />
                                    <Button Command="{Binding CancelDialogCommand}"
                                            Content="{DynamicResource LOCFullscreenCancel}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
